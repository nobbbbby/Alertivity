        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte aplikáciu alebo spustiteľný súbor na vylúčenie zo sledovania procesov s vysokou aktivitou."
          }
        },
        "sl": {
          "stringUnit": {
