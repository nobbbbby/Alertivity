          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura los límites de detección de procesos y gestiona la lista de permitidos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta prosessien tunnistusrajat ja hallitse sallittujen luetteloa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Définir les seuils de détection des processus et gérer les processus ignorés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્રક્રિયા શોધની મર્યાદા સેટ કરો અને છૂટની સૂચિ સંભાળો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרת גבולות זיהוי התהליכים וניהול רשימת ההיתרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोसेस पहचानने की सीमाएँ सेट करें और अनुमत सूची सँभालें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavi granice otkrivanja procesa i upravljaj popisom dopuštenih."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsa be a folyamatészlelés korlátait és kezelje az engedélyezési listát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur batas deteksi proses dan kelola daftar izin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta i limiti di rilevamento dei processi e gestisci l’elenco consentiti."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಕ್ರಿಯೆ ಪತ್ತೆ ಮಿತಿಗಳನ್ನು ಹೊಂದಿಸಿ ಮತ್ತು ವಿನಾಯಿತಿ ಪಟ್ಟಿ ನಿರ್ವಹಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세스 감지 한도를 설정하고 허용 목록을 관리합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രോസസ് കണ്ടെത്തൽ പരിധികൾ ക്രമീകരിച്ച് ഒഴിവാക്കൽ പട്ടിക നിയന്ത്രിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रक्रिया शोधण्याच्या मर्यादा सेट करा आणि परवानगी यादी सांभाळा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan had pengesanan proses dan urus senarai dibenarkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi grenser for prosessoppdagelse og administrer tillatelseslisten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel procesdetectielimieten in en beheer de toegestane lijst."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରୋସେସ୍ ଚିହ୍ନଟ ସୀମା ସେଟ୍ କରି ଛାଡ଼ ତାଲିକା ପରିଚାଳନା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪ੍ਰੋਸੈੱਸ ਪਛਾਣ ਦੀਆਂ ਹੱਦਾਂ ਸੈੱਟ ਕਰੋ ਅਤੇ ਇਜਾਜ਼ਤ ਸੂਚੀ ਸੰਭਾਲੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw limity wykrywania procesów i zarządzaj listą dozwolonych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina os limites de detecção de processos e gerencie a lista de permissões."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina os limites de deteção de processos e faça a gestão da lista de permissões."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setează limitele de detectare a proceselor și gestionează lista de permise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте ограничения обнаружения процессов и список разрешённых."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte limity detekcie procesov a spravujte povolené procesy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavi omejitve zaznavanja procesov in upravljaj seznam dovoljenih."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in gränser för processidentifiering och hantera tillåtelselistan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயல்முறை கண்டறிதல் வரம்புகளை அமைத்து விலக்குப் பட்டியலை நிர்வகிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రాసెస్ గుర్తింపు పరిమితులు సెట్ చేసి మినహాయింపు జాబితా నిర్వహించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่าขีดจำกัดการตรวจจับกระบวนการและจัดการรายการยกเว้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem saptama sınırlarını ayarlayın ve izin listesini yönetin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте межі виявлення процесів і список дозволених."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پراسیس کی شناخت کی حدود مقرر کریں اور مستثنیٰ فہرست سنبھالیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt giới hạn phát hiện tiến trình và quản lý danh sách cho phép."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定程序偵測限制並管理允許清單。"
