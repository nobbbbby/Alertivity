    "settings.sampling.help" : {
      "localizations" : {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shorter intervals respond sooner and use more resources."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kürzere Intervalle reagieren schneller und benötigen mehr Ressourcen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un intervalle court améliore la réactivité et consomme plus de ressources."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間隔を短くすると応答が速くなり、リソース使用量が増えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较短间隔响应更快，也会使用更多资源。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng ngắn hơn phản hồi sớm hơn và dùng nhiều tài nguyên hơn."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટૂંકા અંતરાલ ઝડપી પ્રતિસાદ આપે છે અને વધુ સંસાધન વાપરે છે."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kratšie intervaly reagujú skôr a využívajú viac prostriedkov."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli intervalli più brevi rispondono prima e usano più risorse."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कमी अंतराने लवकर प्रतिसाद मिळतो आणि जास्त संसाधने वापरली जातात."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Shorter intervals respond sooner and use more resources."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम अंतराल पर प्रतिक्रिया जल्दी मिलती है और ज़्यादा संसाधन इस्तेमाल होते हैं।"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Des intervalles plus courts permettent de réagir plus vite et utilisent plus de ressources."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מרווחים קצרים יותר מאפשרים תגובה מהירה יותר וצורכים יותר משאבים."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalele mai scurte răspund mai repede și consumă mai multe resurse."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستجيب الفواصل الأقصر بسرعة أكبر وتستهلك موارد أكثر."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalos mais curtos respondem mais depressa e usam mais recursos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коротші інтервали дають змогу швидше реагувати й споживають більше ресурсів."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyhyemmät välit reagoivat nopeammin ja käyttävät enemmän resursseja."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intervalos más cortos responden antes y usan más recursos."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறைந்த இடைவெளிகள் விரைவாகப் பதிலளிக்கும், அதிக வளங்களைப் பயன்படுத்தும்."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortere intervaller reagerer hurtigere og bruger flere ressourcer."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਛੋਟੇ ਅੰਤਰਾਲ ਜਲਦੀ ਪ੍ਰਤੀਕਿਰਿਆ ਦਿੰਦੇ ਹਨ ਅਤੇ ਵੱਧ ਸਰੋਤ ਵਰਤਦੇ ਹਨ।"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μικρότερα διαστήματα προσφέρουν ταχύτερη απόκριση και χρησιμοποιούν περισσότερους πόρους."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తక్కువ విరామాలు త్వరగా స్పందిస్తాయి, మరిన్ని వనరులు వాడతాయి."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalos menores respondem mais rápido e usam mais recursos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intervalos más cortos responden antes y usan más recursos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha kısa aralıklar daha hızlı yanıt verir ve daha fazla kaynak kullanır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kratší intervaly reagují dříve a využívají více prostředků."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Interval lebih pendek merespons lebih cepat dan menggunakan lebih banyak sumber daya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortere intervaller reagerer raskere og bruker flere ressurser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткие интервалы позволяют быстрее реагировать и потребляют больше ресурсов."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kraći intervali reagiraju brže i troše više resursa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortere intervallen reageren sneller en gebruiken meer bronnen."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಡಿಮೆ ಅಂತರವು ಬೇಗ ಪ್ರತಿಕ್ರಿಯಿಸುತ್ತದೆ ಮತ್ತು ಹೆಚ್ಚು ಸಂಪನ್ಮೂಲ ಬಳಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കുറഞ്ഞ ഇടവേളകൾ വേഗത്തിൽ പ്രതികരിക്കുകയും കൂടുതൽ വിഭവങ്ങൾ ഉപയോഗിക്കുകയും ചെയ്യും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sela lebih pendek bertindak balas lebih cepat dan menggunakan lebih banyak sumber."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিরতি কম হলে দ্রুত সাড়া দেয় এবং বেশি রিসোর্স ব্যবহার করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els intervals més curts responen abans i consumeixen més recursos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rövidebb időközök gyorsabban reagálnak és több erőforrást használnak."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortare intervall reagerar snabbare och använder fler resurser."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krajši intervali se odzovejo prej in porabijo več virov."
