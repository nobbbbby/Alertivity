            "value": "Alertivity Pro से गतिविधि की सीमाएँ और सूचनाओं का समय बदलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagodi pragove aktivnosti i vrijeme obavijesti uz Alertivity Pro."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szabja testre az aktivitási küszöböket és az értesítések időzítését az Alertivity Próval."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan ambang aktivitas dan waktu notifikasi dengan Alertivity Pro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalizza le soglie di attività e i tempi delle notifiche con Alertivity Pro."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertivity Pro ಮೂಲಕ ಚಟುವಟಿಕೆ ಮಿತಿ ಮತ್ತು ಸೂಚನೆಯ ಸಮಯ ಕಸ್ಟಮೈಸ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertivity Pro로 활동 임계값과 알림 시간을 사용자화하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertivity Pro ഉപയോഗിച്ച് ആക്റ്റിവിറ്റി പരിധികളും അറിയിപ്പ് സമയവും ഇഷ്ടാനുസൃതമാക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertivity Pro सह ॲक्टिव्हिटीच्या मर्यादा आणि सूचनांची वेळ बदला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan ambang aktiviti dan masa pemberitahuan dengan Alertivity Pro."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpass aktivitetsgrenser og varslingstidspunkter med Alertivity Pro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas activiteitsdrempels en meldingstijden aan met Alertivity Pro."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertivity Pro ରେ କାର୍ଯ୍ୟକଳାପ ସୀମା ଓ ସୂଚନା ସମୟ କଷ୍ଟମାଇଜ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertivity Pro ਨਾਲ ਸਰਗਰਮੀ ਦੀਆਂ ਹੱਦਾਂ ਅਤੇ ਸੂਚਨਾਵਾਂ ਦਾ ਸਮਾਂ ਬਦਲੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj progi aktywności i czasy powiadomień dzięki Alertivity Pro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalize os limites de atividade e os tempos de notificação com o Alertivity Pro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalize os limites de atividade e os tempos de notificação com o Alertivity Pro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalizează pragurile de activitate și temporizarea notificărilor cu Alertivity Pro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте пороги активности и время уведомлений с Alertivity Pro."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prispôsobte prahy aktivity a časovanie hlásení pomocou Alertivity Pro."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagodi pragove dejavnosti in čas obvestil z Alertivity Pro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassa aktivitetsgränser och notistider med Alertivity Pro."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertivity Pro மூலம் செயல்பாட்டு வரம்புகளையும் அறிவிப்பு நேரத்தையும் தனிப்பயனாக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertivity Pro తో కార్యకలాప పరిమితులు, నోటిఫికేషన్ సమయాన్ని అనుకూలీకరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับแต่งเกณฑ์กิจกรรมและเวลาแจ้งเตือนด้วย Alertivity Pro"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertivity Pro ile etkinlik eşiklerini ve bildirim zamanlamasını özelleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте пороги активності й час сповіщень з Alertivity Pro."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertivity Pro سے سرگرمی کی حدود اور اطلاعات کے اوقات حسب ضرورت بنائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chỉnh ngưỡng hoạt động và thời gian thông báo bằng Alertivity Pro."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Alertivity Pro 自訂活動閾值與通知時間。"
          }
        }
      },
      "extractionState" : "manual"
    },
