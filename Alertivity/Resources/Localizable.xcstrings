    "onboarding.overview.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Menüleistenanzeige für CPU-, Speicher-, Datenträger- und Netzwerkaktivität. Die Überwachung läuft bereits."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the menu bar indicator to see CPU, memory, disk, and network activity. Monitoring is already running."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez l’indicateur de la barre des menus pour voir l’activité du processeur, de la mémoire, du disque et du réseau. La surveillance est déjà active."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーのアイコンからCPU、メモリ、ディスク、ネットワークの使用状況を確認できます。監視はすでに動作しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击菜单栏指示器查看 CPU、内存、磁盘和网络活动。监测已在运行。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن فتح مؤشر شريط القوائم لعرض نشاط CPU والذاكرة والقرص والشبكة. المراقبة قيد التشغيل بالفعل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, মেমরি, ডিস্ক ও নেটওয়ার্কের অ্যাক্টিভিটি দেখতে মেনু বারের নির্দেশক খুলুন। পর্যবেক্ষণ ইতিমধ্যে চলছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre l’indicador de la barra de menús per veure l’activitat de CPU, memòria, disc i xarxa. La supervisió ja està en marxa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete ukazatel na řádku nabídek a zobrazte aktivitu CPU, paměti, disku a sítě. Sledování již běží."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn indikatoren på menulinjen for at se CPU-, hukommelses-, disk- og netværksaktivitet. Overvågningen kører allerede."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε την ένδειξη στη γραμμή μενού για τη δραστηριότητα CPU, μνήμης, δίσκου και δικτύου. Η παρακολούθηση εκτελείται ήδη."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the menu bar indicator to see CPU, memory, disk and network activity. Monitoring is already running."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the menu bar indicator to see CPU, memory, disk and network activity. Monitoring is already running."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the menu bar indicator to see CPU, memory, disk and network activity. Monitoring is already running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el indicador de la barra de menús para ver la actividad de CPU, memoria, disco y red. La supervisión ya está activa."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el indicador de la barra de menús para ver la actividad de CPU, memoria, disco y red. La supervisión ya está activa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa valikkorivin ilmaisin nähdäksesi CPU:n, muistin, levyn ja verkon aktiivisuuden. Seuranta on jo käynnissä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’indicateur de la barre des menus pour voir l’activité du processeur, de la mémoire, du disque et du réseau. La surveillance est déjà active."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, મેમરી, ડિસ્ક અને નેટવર્ક પ્રવૃત્તિ જોવા મેનૂ બાર સૂચક ખોલો. નિરીક્ષણ પહેલેથી ચાલુ છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לפתוח את המחוון בשורת התפריטים לצפייה בפעילות CPU, זיכרון, כונן ורשת. הניטור כבר פועל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, मेमोरी, डिस्क और नेटवर्क की गतिविधि देखने के लिए मेनू बार संकेतक खोलें। निगरानी पहले से चल रही है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori indikator u traci izbornika za prikaz aktivnosti CPU-a, memorije, diska i mreže. Praćenje je već pokrenuto."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyissa meg a menüsáv jelzőjét a CPU, memória, lemez és hálózat aktivitásához. A figyelés már fut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka indikator bar menu untuk melihat aktivitas CPU, memori, disk, dan jaringan. Pemantauan sudah berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri l’indicatore nella barra dei menu per vedere l’attività di CPU, memoria, disco e rete. Il monitoraggio è già attivo."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, ಮೆಮೊರಿ, ಡಿಸ್ಕ್ ಮತ್ತು ನೆಟ್‌ವರ್ಕ್ ಚಟುವಟಿಕೆ ನೋಡಲು ಮೆನು ಬಾರ್ ಸೂಚಕ ತೆರೆಯಿರಿ. ಮೇಲ್ವಿಚಾರಣೆ ಈಗಾಗಲೇ ಚಾಲನೆಯಲ್ಲಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대의 표시기를 열어 CPU, 메모리, 디스크 및 네트워크 활동을 확인하십시오. 모니터링이 이미 실행 중입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, മെമ്മറി, ഡിസ്ക്, നെറ്റ്‌വർക്ക് ആക്റ്റിവിറ്റി കാണാൻ മെനു ബാറിലെ സൂചകം തുറക്കൂ. നിരീക്ഷണം ഇതിനകം പ്രവർത്തിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, मेमरी, डिस्क आणि नेटवर्कची ॲक्टिव्हिटी पाहण्यासाठी मेनू बारमधील दर्शक उघडा. निरीक्षण आधीच सुरू आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka penunjuk bar menu untuk melihat aktiviti CPU, memori, cakera dan rangkaian. Pemantauan sudah berjalan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne indikatoren i menylinjen for å se CPU-, minne-, disk- og nettverksaktivitet. Overvåkingen kjører allerede."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de menubalkindicator om CPU-, geheugen-, schijf- en netwerkactiviteit te bekijken. De bewaking is al actief."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, ମେମୋରି, ଡିସ୍କ୍ ଓ ନେଟୱର୍କ୍ କାର୍ଯ୍ୟକଳାପ ଦେଖିବାକୁ ମେନୁ ବାର୍ ସୂଚକ ଖୋଲନ୍ତୁ। ନିରୀକ୍ଷଣ ପୂର୍ବରୁ ଚାଲିଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, ਮੈਮੋਰੀ, ਡਿਸਕ ਅਤੇ ਨੈੱਟਵਰਕ ਦੀ ਸਰਗਰਮੀ ਦੇਖਣ ਲਈ ਮੀਨੂ ਬਾਰ ਸੰਕੇਤਕ ਖੋਲ੍ਹੋ। ਨਿਗਰਾਨੀ ਪਹਿਲਾਂ ਹੀ ਚੱਲ ਰਹੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz wskaźnik na pasku menu, aby zobaczyć aktywność CPU, pamięci, dysku i sieci. Monitorowanie już działa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o indicador da barra de menus para ver a atividade de CPU, memória, disco e rede. O monitoramento já está em execução."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o indicador da barra de menus para ver a atividade de CPU, memória, disco e rede. A monitorização já está em execução."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide indicatorul din bara de meniu pentru activitatea CPU, memoriei, discului și rețelei. Monitorizarea rulează deja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте индикатор в строке меню, чтобы увидеть активность CPU, памяти, диска и сети. Мониторинг уже работает."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte ukazovateľ v lište a pozrite si aktivitu CPU, pamäte, disku a siete. Sledovanie už beží."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpri kazalnik v menijski vrstici za ogled dejavnosti CPU, pomnilnika, diska in omrežja. Spremljanje že poteka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna indikatorn i menyraden för att se aktivitet för CPU, minne, skiva och nätverk. Övervakningen är redan igång."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, நினைவகம், வட்டு, நெட்வொர்க் செயல்பாட்டைக் காண மெனு பட்டிக் குறிகாட்டியைத் திறக்கவும். கண்காணிப்பு ஏற்கெனவே நடக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, మెమరీ, డిస్క్, నెట్‌వర్క్ కార్యకలాపం చూడటానికి మెను బార్ సూచిక తెరవండి. పర్యవేక్షణ ఇప్పటికే నడుస్తోంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดตัวแสดงในแถบเมนูเพื่อดูกิจกรรม CPU หน่วยความจำ ดิสก์ และเครือข่าย การตรวจสอบกำลังทำงานอยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU, bellek, disk ve ağ etkinliğini görmek için menü çubuğu göstergesini açın. İzleme zaten çalışıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте індикатор на смузі меню, щоб побачити активність CPU, памʼяті, диска й мережі. Моніторинг уже працює."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU، میموری، ڈسک اور نیٹ ورک کی سرگرمی دیکھنے کے لیے مینو بار کا اشارہ کھولیں۔ نگرانی پہلے سے جاری ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở chỉ báo thanh menu để xem hoạt động CPU, bộ nhớ, ổ đĩa và mạng. Tính năng giám sát đã chạy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟選單列指示器即可查看 CPU、記憶體、磁碟和網路活動。監控已在執行中。"
          }
        }
      }
    },
    "onboarding.overview.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
