          "stringUnit": {
            "state": "translated",
            "value": "Alege când apare indicatorul și ce afișează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, когда появляется индикатор и что он показывает."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, kedy sa ukazovateľ zobrazuje a čo ukazuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
