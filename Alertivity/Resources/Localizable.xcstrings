    "settings.ignoredProcesses.help" : {
      "comment" : "Explains the effect and limits of ignoring a process.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prozesse auf der Ausnahmeliste werden nicht in Warnungen zu hoher Aktivität angezeigt, ihre Nutzung wird jedoch weiterhin in die allgemeinen Systemmetriken einbezogen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whitelisted processes won’t appear in high-activity alerts, but their usage still counts toward overall system metrics."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les processus ignorés n’apparaîtront pas dans les alertes de forte activité, mais leur utilisation sera toujours prise en compte dans les métriques système globales."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無視するプロセスは高負荷の通知には表示されませんが、その使用量は引き続きシステム全体の指標に含まれます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忽略列表中的进程不会出现在高活动提醒中，但其资源使用情况仍会计入整体系统指标。"
          }
        }
      }
    },
