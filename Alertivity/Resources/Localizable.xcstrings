            "value": "App Store తెరవలేకపోయాం. తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด App Store ไม่ได้ โปรดลองอีกครั้งภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store açılamadı. Lütfen daha sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити App Store. Спробуйте пізніше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store نہیں کھل سکا۔ بعد میں دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể mở App Store. Vui lòng thử lại sau."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟 App Store。請稍後再試。"
          }
        }
      }
    },
