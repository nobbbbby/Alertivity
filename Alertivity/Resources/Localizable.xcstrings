    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro is currently unavailable for purchase. You can still restore an existing purchase."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro kann derzeit nicht gekauft werden. Vorhandene Käufe können weiterhin wiederhergestellt werden."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro n’est pas disponible à l’achat pour le moment. Vous pouvez toujours restaurer un achat existant."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "現在 Pro を購入できません。購入済みの場合は復元できます。"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro 暂时无法购买。您仍可恢复已有购买。"
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro غير متاح للشراء حاليًا. لا تزال استعادة عملية شراء سابقة متاحة."
        }
      },
      "bn": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro এখন কেনা যাচ্ছে না। আগের কেনাকাটা রিস্টোর করতে পারেন।"
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "Ara no es pot comprar el Pro. Encara pots restaurar una compra existent."
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro nyní nelze zakoupit. Stávající nákup můžete nadále obnovit."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro kan ikke købes lige nu. Du kan stadig gendanne et eksisterende køb."
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Το Pro δεν είναι προς το παρόν διαθέσιμο για αγορά. Μπορείτε να επαναφέρετε μια υπάρχουσα αγορά."
        }
      },
      "en-AU": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro is currently unavailable for purchase. You can still restore an existing purchase."
        }
      },
      "en-CA": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro is currently unavailable for purchase. You can still restore an existing purchase."
        }
      },
      "en-GB": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro is currently unavailable for purchase. You can still restore an existing purchase."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro no está disponible para comprar en este momento. Puedes restaurar una compra existente."
        }
      },
      "es-MX": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro no está disponible para comprar en este momento. Puedes restaurar una compra existente."
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Prota ei voi ostaa juuri nyt. Voit silti palauttaa aiemman ostoksen."
        }
      },
      "fr-CA": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro n’est pas disponible à l’achat pour le moment. Vous pouvez toujours restaurer un achat existant."
        }
      },
      "gu": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro હાલમાં ખરીદી માટે ઉપલબ્ધ નથી. અગાઉની ખરીદી પુનઃસ્થાપિત કરી શકો છો."
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro אינו זמין כעת לרכישה. עדיין ניתן לשחזר רכישה קיימת."
        }
      },
      "hi": {
        "stringUnit": {
          "state": "translated",
          "value": "अभी Pro ख़रीदने के लिए उपलब्ध नहीं है। पिछली ख़रीदारी अब भी रीस्टोर कर सकते हैं।"
        }
      },
      "hr": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro trenutačno nije dostupan za kupnju. I dalje možeš obnoviti postojeću kupnju."
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "A Pro jelenleg nem vásárolható meg. Meglévő vásárlását továbbra is visszaállíthatja."
        }
      },
      "id": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro sedang tidak tersedia untuk dibeli. Anda masih dapat memulihkan pembelian yang ada."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro non è attualmente disponibile per l’acquisto. Puoi comunque ripristinare un acquisto esistente."
        }
      },
      "kn": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro ಸದ್ಯ ಖರೀದಿಗೆ ಲಭ್ಯವಿಲ್ಲ. ಹಿಂದಿನ ಖರೀದಿಯನ್ನು ಮರುಸ್ಥಾಪಿಸಬಹುದು."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "현재 Pro를 구매할 수 없습니다. 기존 구입 항목은 복원할 수 있습니다."
        }
      },
      "ml": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro ഇപ്പോൾ വാങ്ങാനാകില്ല. മുമ്പത്തെ വാങ്ങൽ പുനഃസ്ഥാപിക്കാം."
        }
      },
      "mr": {
        "stringUnit": {
          "state": "translated",
          "value": "सध्या Pro खरेदीसाठी उपलब्ध नाही. आधीची खरेदी पुनर्संचयित करता येते."
        }
      },
      "ms": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro tidak tersedia untuk pembelian buat masa ini. Anda masih boleh memulihkan pembelian sedia ada."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro kan ikke kjøpes akkurat nå. Du kan fortsatt gjenopprette et eksisterende kjøp."
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro is momenteel niet te koop. Je kunt een bestaande aankoop wel herstellen."
        }
      },
      "or": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro ଏବେ କ୍ରୟ ପାଇଁ ଉପଲବ୍ଧ ନାହିଁ। ପୂର୍ବ କ୍ରୟ ପୁନଃସ୍ଥାପନ କରିପାରିବେ।"
        }
      },
      "pa": {
        "stringUnit": {
          "state": "translated",
          "value": "ਇਸ ਵੇਲੇ Pro ਖ਼ਰੀਦਣ ਲਈ ਉਪਲਬਧ ਨਹੀਂ ਹੈ। ਪਹਿਲਾਂ ਦੀ ਖ਼ਰੀਦ ਹੁਣ ਵੀ ਮੁੜ-ਬਹਾਲ ਕਰ ਸਕਦੇ ਹੋ।"
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro nie jest teraz dostępne do zakupu. Nadal możesz odtworzyć istniejący zakup."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "O Pro está indisponível para compra no momento. Você ainda pode restaurar uma compra existente."
        }
      },
      "pt-PT": {
        "stringUnit": {
          "state": "translated",
          "value": "O Pro está indisponível para compra neste momento. Ainda pode restaurar uma compra existente."
        }
      },
      "ro": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro nu este disponibil momentan pentru cumpărare. Poți restaura în continuare o achiziție existentă."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro сейчас недоступен для покупки. Имеющуюся покупку по-прежнему можно восстановить."
        }
      },
      "sk": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro momentálne nie je možné kúpiť. Existujúci nákup môžete naďalej obnoviť."
        }
      },
      "sl": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro trenutno ni na voljo za nakup. Obstoječi nakup lahko še vedno obnoviš."
        }
      },
      "sv": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro kan inte köpas just nu. Du kan fortfarande återskapa ett befintligt köp."
        }
      },
      "ta": {
        "stringUnit": {
          "state": "translated",
          "value": "தற்போது Pro ஐ வாங்க முடியாது. ஏற்கெனவே வாங்கியதை மீட்டெடுக்கலாம்."
        }
      },
      "te": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro ప్రస్తుతం కొనుగోలుకు అందుబాటులో లేదు. గత కొనుగోలును పునరుద్ధరించవచ్చు."
        }
      },
      "th": {
        "stringUnit": {
          "state": "translated",
          "value": "ยังซื้อ Pro ไม่ได้ในขณะนี้ คุณยังกู้คืนรายการซื้อเดิมได้"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro şu anda satın alınamıyor. Mevcut satın alımınızı yine de geri yükleyebilirsiniz."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro зараз недоступний для придбання. Наявну покупку можна відновити."
        }
      },
      "ur": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro فی الحال خریدنے کے لیے دستیاب نہیں۔ پہلے کی خریداری بحال کر سکتے ہیں۔"
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Hiện không thể mua Pro. Bạn vẫn có thể khôi phục giao dịch mua hiện có."
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "目前無法購買 Pro，仍可回復現有購買項目。"
        }
      }
    }
  },
