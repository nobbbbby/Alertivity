    "settings.menuBar.autoSwitch.priority.help" : {
      "localizations" : {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At equal severity, the first eligible metric wins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei gleichem Schweregrad gewinnt die erste passende Metrik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À gravité égale, la première métrique admissible est choisie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティビティレベルが同じ場合は、条件を満たす最初の指標が優先されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "严重程度相同时，优先选择排序靠前的符合条件的指标。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تساوي مستوى الخطورة، تكون الأولوية لأول مقياس مؤهل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তীব্রতা সমান হলে প্রথম যোগ্য মেট্রিকটি বেছে নেওয়া হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb la mateixa gravetat, té prioritat la primera mètrica que compleix els requisits."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při stejné závažnosti má přednost první vyhovující metrika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved samme alvorlighed vinder den første kvalificerede metrik."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε ίδια σοβαρότητα, επιλέγεται η πρώτη κατάλληλη μέτρηση."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "At equal severity, the first eligible metric wins."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "At equal severity, the first eligible metric wins."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "At equal severity, the first eligible metric wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la misma gravedad, tiene prioridad la primera métrica que cumpla los requisitos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la misma gravedad, tiene prioridad la primera métrica que cumpla los requisitos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Samalla vakavuustasolla ensimmäinen ehdot täyttävä mittari on etusijalla."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "À gravité égale, la première métrique admissible a la priorité."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ગંભીરતા સમાન હોય ત્યારે પહેલો લાયક માપદંડ પસંદ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברמת חומרה שווה, המדד הראשון שעומד בתנאים מקבל עדיפות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समान गंभीरता पर, शर्तें पूरी करने वाले पहले मेट्रिक को प्राथमिकता मिलती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri jednakoj ozbiljnosti prednost ima prvi mjerni podatak koji ispunjava uvjete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azonos súlyosság esetén az első megfelelő mérőszám élvez elsőbbséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada tingkat keparahan yang sama, metrik pertama yang memenuhi syarat diprioritaskan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A parità di gravità, ha la precedenza la prima metrica idonea."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತೀವ್ರತೆ ಸಮಾನವಾದಾಗ ಮೊದಲ ಅರ್ಹ ಮಾಪನವನ್ನು ಆಯ್ಕೆಮಾಡಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심각도가 같으면 조건에 맞는 첫 번째 지표가 우선합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തീവ്രത തുല്യമെങ്കിൽ ആദ്യ യോഗ്യമായ മെട്രിക്ക് തിരഞ്ഞെടുക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तीव्रता समान असल्यास पहिला पात्र मेट्रिक निवडला जातो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada tahap keterukan yang sama, metrik pertama yang layak diutamakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved lik alvorlighetsgrad prioriteres den første kvalifiserte målingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij gelijke ernst krijgt de eerste geschikte metriek voorrang."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗୁରୁତ୍ୱ ସମାନ ହେଲେ ପ୍ରଥମ ଯୋଗ୍ୟ ମାପକ ବଛାଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੀਬਰਤਾ ਇੱਕੋ ਹੋਣ ’ਤੇ ਪਹਿਲਾ ਯੋਗ ਮੈਟ੍ਰਿਕ ਚੁਣਿਆ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy jednakowym poziomie alarmowym pierwszeństwo ma pierwszy kwalifikujący się wskaźnik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a mesma gravidade, a primeira métrica elegível tem prioridade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a mesma gravidade, a primeira métrica elegível tem prioridade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La aceeași gravitate, are prioritate primul indicator eligibil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При одинаковой степени серьёзности приоритет у первого подходящего показателя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri rovnakej závažnosti má prednosť prvá vyhovujúca metrika."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri enaki resnosti ima prednost prva meritev, ki izpolnjuje pogoje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vid samma allvarlighetsgrad prioriteras det första kvalificerade mätvärdet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தீவிர நிலை ஒரே அளவில் இருந்தால் முதல் தகுதியான அளவீடு தேர்ந்தெடுக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తీవ్రత సమానంగా ఉంటే మొదటి అర్హమైన కొలమానం ఎంపికవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อความรุนแรงเท่ากัน จะเลือกตัววัดแรกที่เข้าเกณฑ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önem düzeyi eşitse ilk uygun ölçüm önceliklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За однакової серйозності пріоритет має перший відповідний показник."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شدت برابر ہو تو پہلا اہل پیمانہ منتخب ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở cùng mức nghiêm trọng, chỉ số đủ điều kiện đầu tiên được ưu tiên."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嚴重程度相同時，優先選擇第一個符合條件的指標。"
          }
        }
      }
    },
