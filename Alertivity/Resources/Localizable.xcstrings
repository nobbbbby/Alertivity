    "onboarding.finish.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst ohne Mitteilungen weiter überwachen. Öffne Erste Schritte erneut im Hilfemenü."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can keep monitoring without notifications. Revisit Getting Started from the Help menu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez continuer la surveillance sans notifications. Retrouvez Premiers pas dans le menu Aide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知なしでも監視を続けられます。「はじめに」はヘルプメニューから再度開けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不启用通知也能继续监测。可从“帮助”菜单再次打开“使用入门”。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن مواصلة المراقبة دون إشعارات. يمكن فتح البدء مرة أخرى من قائمة المساعدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোটিফিকেশন ছাড়াও পর্যবেক্ষণ চালাতে পারেন। সহায়তা মেনু থেকে শুরুর নির্দেশিকা আবার খুলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots continuar la supervisió sense notificacions. Torna a Primers passos des del menú Ajuda."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledování může pokračovat bez oznámení. Průvodce Začínáme znovu otevřete v nabídce Nápověda."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortsætte overvågningen uden notifikationer. Åbn Kom godt i gang igen fra menuen Hjælp."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να συνεχίσετε την παρακολούθηση χωρίς ειδοποιήσεις. Ανοίξτε ξανά τα Πρώτα βήματα από το μενού Βοήθεια."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can keep monitoring without notifications. Revisit Getting Started from the Help menu."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "You can keep monitoring without notifications. Revisit Getting Started from the Help menu."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can keep monitoring without notifications. Revisit Getting Started from the Help menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes seguir supervisando sin notificaciones. Vuelve a Primeros pasos desde el menú Ayuda."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes seguir supervisando sin notificaciones. Vuelve a Primeros pasos desde el menú Ayuda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit jatkaa seurantaa ilman ilmoituksia. Avaa Aloittaminen uudelleen Ohje-valikosta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez continuer la surveillance sans notifications. Retrouvez Premiers pas dans le menu Aide."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૂચના વિના પણ નિરીક્ષણ ચાલુ રાખી શકો છો. મદદ મેનૂમાંથી શરૂઆતની માર્ગદર્શિકા ફરી ખોલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להמשיך בניטור ללא עדכונים. ניתן לפתוח שוב את תחילת העבודה מתפריט העזרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना सूचनाओं के भी निगरानी जारी रख सकते हैं। सहायता मेनू से “शुरुआत करें” फिर से खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Praćenje se može nastaviti bez obavijesti. Ponovno otvori Prve korake iz izbornika Pomoć."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítések nélkül is folytathatja a figyelést. Az Első lépések a Súgó menüből újra megnyitható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat memantau tanpa notifikasi. Buka Memulai dari menu Bantuan untuk melihat kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi continuare il monitoraggio senza notifiche. Riapri Primi passi dal menu Aiuto."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೂಚನೆಗಳಿಲ್ಲದೆಯೂ ಮೇಲ್ವಿಚಾರಣೆ ಮುಂದುವರಿಸಬಹುದು. ಸಹಾಯ ಮೆನುವಿನಿಂದ ಪ್ರಾರಂಭ ಮಾರ್ಗದರ್ಶಿಯನ್ನು ಮತ್ತೆ ತೆರೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 없이도 모니터링할 수 있습니다. 도움말 메뉴에서 시작하기를 다시 열 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അറിയിപ്പുകളില്ലാതെയും നിരീക്ഷണം തുടരാം. സഹായ മെനുവിൽ നിന്ന് തുടക്ക മാർഗദർശി വീണ്ടും തുറക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनांशिवायही निरीक्षण सुरू ठेवता येते. मदत मेनूमधून ‘सुरुवात करा’ पुन्हा उघडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh terus memantau tanpa pemberitahuan. Buka Bermula daripada menu Bantuan untuk melihat semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortsette overvåkingen uten varslinger. Åpne Kom i gang på nytt fra Hjelp-menyen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt zonder meldingen blijven bewaken. Open Aan de slag opnieuw via het Help-menu."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସୂଚନା ବିନା ମଧ୍ୟ ନିରୀକ୍ଷଣ ଜାରି ରଖିପାରିବେ। ସହାୟତା ମେନୁରୁ ଆରମ୍ଭ ମାର୍ଗଦର୍ଶିକା ପୁଣି ଖୋଲନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੂਚਨਾਵਾਂ ਤੋਂ ਬਿਨਾਂ ਵੀ ਨਿਗਰਾਨੀ ਜਾਰੀ ਰੱਖ ਸਕਦੇ ਹੋ। ਮਦਦ ਮੀਨੂ ਵਿੱਚੋਂ “ਸ਼ੁਰੂਆਤ ਕਰੋ” ਮੁੜ ਖੋਲ੍ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz kontynuować monitorowanie bez powiadomień. Otwórz ponownie Pierwsze kroki w menu Pomoc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode continuar o monitoramento sem notificações. Acesse Primeiros Passos no menu Ajuda para rever estas etapas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode continuar a monitorização sem notificações. Aceda a Primeiros passos no menu Ajuda para rever estas etapas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți continua monitorizarea fără notificări. Redeschide Primii pași din meniul Ajutor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мониторинг работает и без уведомлений. Снова откройте «Начало работы» в меню «Справка»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledovanie môže pokračovať bez hlásení. Sprievodcu Začíname znovu otvoríte v menu Pomocník."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremljanje se lahko nadaljuje brez obvestil. V meniju Pomoč znova odpri Prve korake."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortsätta övervakningen utan notiser. Öppna Kom igång igen från Hjälp-menyn."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறிவிப்புகள் இல்லாமலும் கண்காணிப்பைத் தொடரலாம். உதவி மெனுவில் தொடங்குதல் வழிகாட்டியை மீண்டும் திறக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నోటిఫికేషన్‌లు లేకుండానూ పర్యవేక్షణ కొనసాగించవచ్చు. సహాయ మెనులో ప్రారంభ మార్గదర్శిని మళ్లీ తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบต่อได้โดยไม่ต้องรับการแจ้งเตือน เปิดการเริ่มต้นใช้งานอีกครั้งได้จากเมนูวิธีใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler olmadan izlemeyi sürdürebilirsiniz. Yardım menüsünden Başlangıç bölümünü yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Моніторинг працює і без сповіщень. Знову відкрийте «Початок роботи» в меню «Довідка»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعات کے بغیر بھی نگرانی جاری رکھ سکتے ہیں۔ مدد کے مینو سے آغاز کی رہنمائی دوبارہ کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể tiếp tục giám sát mà không cần thông báo. Mở lại Bắt đầu từ menu Trợ giúp."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使不啟用通知，仍可繼續監控。可從「輔助說明」選單重新開啟「開始使用」。"
          }
        }
      }
    },
