  },
  "pro.lock.thresholds": {
    "comment": "AL-79: Pro lock hover help or optional onboarding introduction.",
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Requires Alertivity Pro. Free monitoring uses the default thresholds."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Erfordert Alertivity Pro. Die kostenlose Überwachung verwendet die Standardschwellenwerte."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Nécessite Alertivity Pro. La surveillance gratuite utilise les seuils par défaut."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "Alertivity Pro が必要です。無料の監視にはデフォルトのしきい値が使われます。"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "需要 Alertivity Pro。免费监控使用默认阈值。"
        }
      }
    }
  },
  "pro.lock.cooldown": {
    "comment": "AL-79: Pro lock hover help or optional onboarding introduction.",
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Requires Alertivity Pro. Free monitoring uses a 10-minute notification cooldown."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Erfordert Alertivity Pro. Die kostenlose Überwachung verwendet einen Benachrichtigungsabstand von 10 Minuten."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Nécessite Alertivity Pro. La surveillance gratuite utilise un délai de 10 minutes entre les notifications."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "Alertivity Pro が必要です。無料の監視では通知間隔は10分です。"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "需要 Alertivity Pro。免费监控的通知冷却时间为 10 分钟。"
        }
      }
    }
  },
  "pro.lock.duration": {
    "comment": "AL-79: Pro lock hover help or optional onboarding introduction.",
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Requires Alertivity Pro. Free monitoring uses a 60-second high-activity duration."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Erfordert Alertivity Pro. Die kostenlose Überwachung verwendet eine Dauer hoher Aktivität von 60 Sekunden."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Nécessite Alertivity Pro. La surveillance gratuite utilise une durée d’activité élevée de 60 secondes."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "Alertivity Pro が必要です。無料の監視では高負荷の継続時間は60秒です。"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "需要 Alertivity Pro。免费监控的高活动持续时间为 60 秒。"
        }
      }
    }
  },
  "onboarding.pro.help": {
    "comment": "AL-79: Pro lock hover help or optional onboarding introduction.",
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Monitoring and notifications are free with the default settings. Pro lets you customize:"
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Überwachung und Benachrichtigungen sind mit den Standardeinstellungen kostenlos. Mit Pro kannst du Folgendes anpassen:"
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "La surveillance et les notifications sont gratuites avec les réglages par défaut. Pro vous permet de personnaliser :"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "デフォルト設定での監視と通知は無料です。Pro では次の項目をカスタマイズできます："
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "使用默认设置的监控和通知免费。Pro 可让您自定义："
        }
      }
    }
  },
  "onboarding.pro.settings": {
    "comment": "AL-79: Pro lock hover help or optional onboarding introduction.",
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "You can unlock Pro anytime in Settings → Pro."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Du kannst Pro jederzeit unter Einstellungen → Pro freischalten."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Vous pouvez déverrouiller Pro à tout moment dans Réglages → Pro."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "「設定 → Pro」からいつでも Pro を購入できます。"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "您可随时在“设置 → Pro”中解锁。"
        }
      }
    }
  },
