          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدیلی کی سطح: %@؛ ورنہ پہلے سے طے شدہ آئیکن استعمال کریں۔"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在%@時切換，否則使用預設圖像。"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବଦଳ ସ୍ତର: %@; ନଚେତ୍ ଡିଫଲ୍ଟ ଆଇକନ୍ ବ୍ୟବହାର କରନ୍ତୁ।"
