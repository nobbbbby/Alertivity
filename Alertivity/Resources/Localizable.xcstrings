          "stringUnit": {
            "state": "translated",
            "value": "Escolha quando o indicador aparece e o que ele mostra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quando o indicador aparece e o que ele mostra."
          }
        },
