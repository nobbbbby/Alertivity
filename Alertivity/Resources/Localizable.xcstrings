    "settings.menuBar.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wann der Indikator erscheint und was er anzeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose when the indicator appears and what it shows."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez quand l'indicateur apparaît et ce qu'il affiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インジケーターを表示するタイミングと内容を選択します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择指示器何时出现以及显示内容。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار وقت ظهور المؤشر وما يعرضه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্দেশক কখন দেখাবে ও কী দেখাবে তা বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria quan apareix l’indicador i què mostra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, kdy se ukazatel zobrazuje a co ukazuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvornår indikatoren vises, og hvad den viser."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε πότε εμφανίζεται η ένδειξη και τι δείχνει."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose when the indicator appears and what it shows."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose when the indicator appears and what it shows."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose when the indicator appears and what it shows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuándo aparece el indicador y qué muestra."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuándo aparece el indicador y qué muestra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, milloin ilmaisin näkyy ja mitä se näyttää."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez quand l’indicateur apparaît et ce qu’il affiche."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૂચક ક્યારે દેખાય અને શું બતાવે તે પસંદ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחירה במועד הופעת המחוון ובתוכן שיוצג בו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि संकेतक कब दिखे और क्या दिखाए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi kada se indikator pojavljuje i što prikazuje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki, mikor jelenjen meg a jelző, és mit mutasson."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kapan indikator muncul dan apa yang ditampilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quando appare l’indicatore e cosa mostra."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೂಚಕ ಯಾವಾಗ ಕಾಣಬೇಕು ಮತ್ತು ಏನು ತೋರಿಸಬೇಕು ಎಂಬುದನ್ನು ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시기가 나타나는 시점과 표시할 내용을 선택하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൂചകം എപ്പോൾ കാണണം, എന്ത് കാണിക്കണം എന്നു തിരഞ്ഞെടുക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दर्शक कधी दिसावा आणि काय दाखवावे ते निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih masa penunjuk muncul dan perkara yang ditunjukkannya."
