    "settings.thresholds.error.order" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder erhöhte Schwellenwert muss unter dem zugehörigen kritischen Schwellenwert liegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each elevated threshold must be lower than its critical threshold."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque seuil élevé doit être inférieur au seuil critique correspondant."
