        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התראה לאחר %d שנ׳ של פעילות קריטית, במרווח של %@ לפחות. כולל תהליכים בעלי פעילות גבוהה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गंभीर गतिविधि के %d सेकंड बाद, कम से कम %@ के अंतराल पर अलर्ट देता है। अधिक गतिविधि वाले प्रोसेस शामिल हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozorava nakon %d s kritične aktivnosti, s razmakom od najmanje %@. Uključuje procese s visokom aktivnošću."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Riaszt %d mp kritikus aktivitás után, legalább %@ időközzel. A magas aktivitású folyamatokat is tartalmazza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan setelah %d dtk aktivitas Kritis, dengan jeda minimal %@. Termasuk proses beraktivitas tinggi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisa dopo %d s di attività critica, con un intervallo di almeno %@. Include i processi ad attività elevata."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d ಸೆಕೆಂಡುಗಳ ಗಂಭೀರ ಚಟುವಟಿಕೆಯ ನಂತರ ಕನಿಷ್ಠ %2$@ ಅಂತರದಲ್ಲಿ ಎಚ್ಚರಿಸುತ್ತದೆ. ಹೆಚ್ಚಿನ ಚಟುವಟಿಕೆ ಪ್ರಕ್ರಿಯೆಗಳೂ ಸೇರಿವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심각한 활동이 %d초 지속되면 최소 %@ 간격으로 알립니다. 활동이 높은 프로세스도 포함됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d സെക്കൻഡ് ഗുരുതര ആക്റ്റിവിറ്റിക്ക് ശേഷം, കുറഞ്ഞത് %2$@ ഇടവേളയിൽ മുന്നറിയിപ്പ്. ഉയർന്ന ആക്റ്റിവിറ്റി പ്രോസസുകളും ഉൾപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गंभीर ॲक्टिव्हिटीच्या %d सेकंदांनंतर, किमान %@ अंतराने सूचना देते. उच्च ॲक्टिव्हिटीच्या प्रक्रिया समाविष्ट आहेत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaran selepas %d s aktiviti Kritikal, dengan sela sekurang-kurangnya %@. Termasuk proses beraktiviti tinggi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler etter %d sek. med kritisk aktivitet, med minst %@ mellom varsler. Inkluderer prosesser med høy aktivitet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarschuwt na %d s kritieke activiteit, met minstens %@ ertussen. Inclusief processen met hoge activiteit."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d ସେକେଣ୍ଡ୍ ଗୁରୁତର କାର୍ଯ୍ୟକଳାପ ପରେ, ଅତିକମରେ %2$@ ବ୍ୟବଧାନରେ ଚେତାବନୀ। ଅଧିକ କାର୍ଯ୍ୟକଳାପର ପ୍ରୋସେସ୍ ମଧ୍ୟ ଅନ୍ତର୍ଭୁକ୍ତ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਗੰਭੀਰ ਸਰਗਰਮੀ ਦੇ %d ਸਕਿੰਟ ਬਾਅਦ, ਘੱਟੋ-ਘੱਟ %@ ਦੇ ਵਕਫ਼ੇ ਨਾਲ ਅਲਰਟ ਦਿੰਦਾ ਹੈ। ਵੱਧ ਸਰਗਰਮੀ ਵਾਲੇ ਪ੍ਰੋਸੈੱਸ ਸ਼ਾਮਲ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadamia po %d s krytycznej aktywności, w odstępach co najmniej %@. Obejmuje procesy o wysokiej aktywności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertas após %d s de atividade Crítica, com intervalo mínimo de %@. Inclui processos com alta atividade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertas após %d s de atividade Crítica, com intervalo mínimo de %@. Inclui processos com atividade elevada."
          }
        },
        "ro": {
