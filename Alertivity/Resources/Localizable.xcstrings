    "settings.ignoredProcesses.picker.message" : {
      "comment" : "Instruction displayed in the standalone process selection panel. Managed manually because it is loaded through L10n.string.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine App oder eine ausführbare Datei aus, die von der Überwachung auf hohe Prozessaktivität ausgeschlossen werden soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose an application or executable to exclude from high-activity process monitoring."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une application ou un fichier exécutable à exclure de la surveillance des processus à forte activité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高負荷プロセスの監視から除外するアプリケーションまたは実行可能ファイルを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择要从高活动进程监控中排除的应用或可执行文件。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى اختيار تطبيق أو ملف قابل للتنفيذ لاستبعاده من مراقبة العمليات ذات النشاط المرتفع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উচ্চ অ্যাক্টিভিটির প্রসেস পর্যবেক্ষণ থেকে বাদ দিতে অ্যাপ বা এক্সিকিউটেবল বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria una aplicació o un executable per excloure’l de la supervisió de processos amb activitat alta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte aplikaci nebo spustitelný soubor k vyloučení ze sledování procesů s vysokou aktivitou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en app eller eksekverbar fil, der skal udelades fra overvågning af processer med høj aktivitet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε εφαρμογή ή εκτελέσιμο για εξαίρεση από την παρακολούθηση διεργασιών υψηλής δραστηριότητας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an application or executable to exclude from high-activity process monitoring."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an application or executable to exclude from high-activity process monitoring."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an application or executable to exclude from high-activity process monitoring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una aplicación o un ejecutable para excluirlo de la supervisión de procesos con actividad elevada."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una aplicación o un ejecutable para excluirlo de la supervisión de procesos con actividad elevada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse appi tai suoritettava tiedosto, joka suljetaan pois suuren aktiivisuuden prosessiseurannasta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une application ou un fichier exécutable à exclure de la surveillance des processus à forte activité."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઊંચી પ્રવૃત્તિની પ્રક્રિયાના નિરીક્ષણમાંથી બાકાત રાખવા ઍપ અથવા એક્ઝિક્યુટેબલ પસંદ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור יישום או קובץ הפעלה כדי להחריג אותו מניטור תהליכים בעלי פעילות גבוהה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिक गतिविधि वाले प्रोसेस की निगरानी से बाहर रखने के लिए ऐप्लिकेशन या चलाने योग्य फ़ाइल चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi aplikaciju ili izvršnu datoteku za izuzimanje iz praćenja procesa s visokom aktivnošću."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon egy alkalmazást vagy végrehajtható fájlt a magas aktivitású folyamatok figyeléséből való kizáráshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih aplikasi atau file yang dapat dijalankan untuk dikecualikan dari pemantauan proses beraktivitas tinggi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un’applicazione o un eseguibile da escludere dal monitoraggio dei processi ad attività elevata."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೆಚ್ಚಿನ ಚಟುವಟಿಕೆ ಪ್ರಕ್ರಿಯೆ ಮೇಲ್ವಿಚಾರಣೆಯಿಂದ ಹೊರಗಿಡಲು ಆ್ಯಪ್ ಅಥವಾ ಕಾರ್ಯಗತ ಫೈಲ್ ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높은 활동 모니터링에서 제외할 응용 프로그램 또는 실행 파일을 선택하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉയർന്ന ആക്റ്റിവിറ്റി പ്രോസസ് നിരീക്ഷണത്തിൽ നിന്ന് ഒഴിവാക്കാൻ ആപ്പ് അല്ലെങ്കിൽ എക്സിക്യൂട്ടബിൾ തിരഞ്ഞെടുക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उच्च ॲक्टिव्हिटीच्या प्रक्रियांचे निरीक्षण वगळण्यासाठी ॲप्लिकेशन किंवा चालवता येणारी फाइल निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih aplikasi atau fail boleh laku untuk dikecualikan daripada pemantauan proses beraktiviti tinggi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en app eller kjørbar fil som skal utelates fra overvåking av prosesser med høy aktivitet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een app of uitvoerbaar bestand om uit te sluiten van bewaking van processen met hoge activiteit."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅଧିକ କାର୍ଯ୍ୟକଳାପ ପ୍ରୋସେସ୍ ନିରୀକ୍ଷଣରୁ ବାଦ୍ ଦେବାକୁ ଆପ୍ କିମ୍ବା ଏକ୍ଜିକ୍ୟୁଟେବଲ୍ ବାଛନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੱਧ ਸਰਗਰਮੀ ਵਾਲੇ ਪ੍ਰੋਸੈੱਸ ਦੀ ਨਿਗਰਾਨੀ ਤੋਂ ਬਾਹਰ ਰੱਖਣ ਲਈ ਐਪਲੀਕੇਸ਼ਨ ਜਾਂ ਚਲਾਉਣਯੋਗ ਫ਼ਾਈਲ ਚੁਣੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz aplikację lub plik wykonywalny do wykluczenia z monitorowania procesów o wysokiej aktywności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um aplicativo ou executável para excluir do monitoramento de processos com alta atividade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma aplicação ou um executável para excluir da monitorização de processos com atividade elevada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege o aplicație sau un executabil de exclus din monitorizarea proceselor cu activitate intensă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите приложение или исполняемый файл для исключения из мониторинга процессов с высокой активностью."
