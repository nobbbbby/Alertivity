    "settings.autoSwitch.activation.help" : {
      "localizations" : {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch at %@; otherwise use the default icon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei %@ umschalten; sonst das Standardsymbol verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basculer au niveau %@ ; sinon utiliser l’icône par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で切り替え、それ以外は既定のアイコンを使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在%@时切换；否则使用默认图标。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển ở mức %@; nếu không, dùng biểu tượng mặc định."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બદલવાનું સ્તર: %@; અન્યથા ડિફૉલ્ટ આઇકન વાપરો."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Úroveň prepínania: %@; inak sa použije predvolená ikona."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia al livello %@; altrimenti usa l’icona predefinita."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलाची पातळी: %@; अन्यथा डीफॉल्ट चिन्ह वापरा."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch at %@; otherwise use the default icon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” पर स्विच करें; वरना डिफ़ॉल्ट आइकॉन इस्तेमाल करें।"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Basculer au niveau « %@ »; sinon, utiliser l’icône par défaut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעבר לפי ״%@״; אחרת נעשה שימוש באייקון ברירת המחדל."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comută la nivelul %@; altfel folosește pictograma implicită."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التبديل عند %@؛ وإلا فتُستخدم الأيقونة الافتراضية."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternar em %@; caso contrário, usar o ícone predefinido."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемикатися на рівні «%@»; інакше використовувати типову іконку."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda tasolla %@; käytä muulloin oletuskuvaketta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar en %@; en otro caso, usar el icono predeterminado."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாறும் நிலை: %@; இல்லையெனில் இயல்புநிலை ஐகானைப் பயன்படுத்தும்."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift ved niveauet %@; brug ellers standardsymbolet."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਦਲਣ ਦਾ ਪੱਧਰ: %@; ਨਹੀਂ ਤਾਂ ਡਿਫ਼ੌਲਟ ਆਈਕਨ ਵਰਤੋ।"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εναλλαγή στο επίπεδο «%@»· διαφορετικά χρήση του προεπιλεγμένου εικονιδίου."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మారే స్థాయి: %@; లేకపోతే డిఫాల్ట్ ఐకాన్ వాడండి."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternar em %@; caso contrário, usar o ícone padrão."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar en %@; en otro caso, usar el icono predeterminado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ düzeyinde geçiş yap; aksi halde saptanmış simgeyi kullan."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepínat při úrovni %@; jinak použít výchozí ikonu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beralih pada %@; selain itu, gunakan ikon default."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt ved nivået %@; bruk ellers standardsymbolet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключаться при уровне «%@»; иначе использовать стандартный значок."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prebaci pri razini %@; inače koristi zadanu ikonu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel bij niveau %@; gebruik anders het standaardsymbool."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬದಲಾವಣೆಯ ಮಟ್ಟ: %@; ಇಲ್ಲದಿದ್ದರೆ ಡೀಫಾಲ್ಟ್ ಐಕಾನ್ ಬಳಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മാറേണ്ട നില: %@; അല്ലാത്തപ്പോൾ ഡിഫോൾട്ട് ഐക്കൺ ഉപയോഗിക്കൂ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bertukar pada %@; jika tidak, gunakan ikon lalai."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বদলানোর স্তর: %@; অন্যথায় ডিফল্ট আইকন ব্যবহার করা হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvia amb el nivell %@; altrament, fes servir la icona predeterminada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Váltás ennél a szintnél: %@; egyébként az alapértelmezett ikon használata."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byt vid nivån %@; använd annars standardsymbolen."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preklopi pri ravni %@; sicer uporabi privzeto ikono."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับที่ระดับ %@ มิฉะนั้นใช้ไอคอนเริ่มต้น"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poziom przełączania: %@; w innym przypadku używaj domyślnej ikony."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch at %@; otherwise use the default icon."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’에서 전환하고 그 외에는 기본 아이콘을 사용합니다."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
