        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রসেস শনাক্তকরণের সীমা সেট করুন ও অনুমোদিত তালিকা পরিচালনা করুন।"
          }
        },
        "ca": {
