    "settings.thresholds.help" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe die Systemaktivitätsstufen an deine Hardware und Arbeitslast an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Customize system activity levels for your hardware and workload."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaptez les niveaux d’activité système à votre matériel et votre charge de travail."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハードウェアと作業負荷に合わせてシステムアクティビティレベルを調整します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据硬件和工作负载自定义系统活动级别。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخصيص مستويات نشاط النظام حسب الأجهزة وحجم العمل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার হার্ডওয়্যার ও কাজের চাপ অনুযায়ী সিস্টেম অ্যাক্টিভিটির স্তর কাস্টমাইজ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalitza els nivells d’activitat del sistema segons el maquinari i la càrrega de treball."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přizpůsobte úrovně aktivity systému hardwaru a pracovní zátěži."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpas systemets aktivitetsniveauer til din hardware og arbejdsbelastning."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσαρμόστε τα επίπεδα δραστηριότητας συστήματος στο υλικό και τον φόρτο εργασίας σας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Customise system activity levels for your hardware and workload."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize system activity levels for your hardware and workload."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Customise system activity levels for your hardware and workload."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Personaliza los niveles de actividad del sistema según tu hardware y carga de trabajo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Personaliza los niveles de actividad del sistema según tu hardware y carga de trabajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukauta järjestelmän aktiivisuustasot laitteistoon ja työkuormaan sopiviksi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptez les niveaux d’activité système à votre matériel et votre charge de travail."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા હાર્ડવેર અને કામના ભાર મુજબ સિસ્ટમ પ્રવૃત્તિના સ્તર કસ્ટમાઇઝ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התאמת רמות פעילות המערכת לחומרה ולעומס העבודה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने हार्डवेयर और काम के अनुसार सिस्टम गतिविधि के स्तर बदलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagodi razine aktivnosti sustava svom hardveru i radnom opterećenju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Igazítsa a rendszer aktivitási szintjeit a hardverhez és a terheléshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan tingkat aktivitas sistem dengan perangkat keras dan beban kerja Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalizza i livelli di attività di sistema in base all’hardware e al carico di lavoro."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಹಾರ್ಡ್‌ವೇರ್ ಮತ್ತು ಕೆಲಸದ ಹೊರೆಗೆ ಸಿಸ್ಟಂ ಚಟುವಟಿಕೆ ಮಟ್ಟಗಳನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하드웨어와 작업량에 맞게 시스템 활동 수준을 사용자화합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഹാർഡ്‌വെയറിനും ജോലിഭാരത്തിനും അനുയോജ്യമായി സിസ്റ്റം ആക്റ്റിവിറ്റി നിലകൾ ഇഷ്ടാനുസൃതമാക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या हार्डवेअर आणि कामानुसार सिस्टम ॲक्टिव्हिटीचे स्तर बदला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan tahap aktiviti sistem untuk perkakasan dan beban kerja anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpass systemets aktivitetsnivåer til maskinvaren og arbeidsbelastningen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas systeemactiviteitsniveaus aan je hardware en werklast aan."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ହାର୍ଡୱେର୍ ଓ କାମ ଭାର ଅନୁସାରେ ସିଷ୍ଟମ୍ କାର୍ଯ୍ୟକଳାପ ସ୍ତର କଷ୍ଟମାଇଜ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ ਹਾਰਡਵੇਅਰ ਅਤੇ ਕੰਮ ਦੇ ਭਾਰ ਮੁਤਾਬਕ ਸਿਸਟਮ ਸਰਗਰਮੀ ਦੇ ਪੱਧਰ ਬਦਲੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj poziomy aktywności systemu do sprzętu i obciążenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalize os níveis de atividade do sistema para seu hardware e sua carga de trabalho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalize os níveis de atividade do sistema para o seu hardware e a sua carga de trabalho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalizează nivelurile de activitate ale sistemului pentru hardware și sarcina de lucru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте уровни активности системы под оборудование и нагрузку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prispôsobte úrovne aktivity systému hardvéru a pracovnej záťaži."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagodi ravni sistemske dejavnosti strojni opremi in obremenitvi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassa systemets aktivitetsnivåer efter maskinvaran och arbetsbelastningen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வன்பொருளுக்கும் பணிச்சுமைக்கும் ஏற்ப கணினிச் செயல்பாட்டு நிலைகளைத் தனிப்பயனாக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ హార్డ్‌వేర్, పనిభారానికి సిస్టమ్ కార్యకలాప స్థాయిలు అనుకూలీకరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับระดับกิจกรรมระบบให้เหมาะกับฮาร์ดแวร์และภาระงานของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem etkinlik düzeylerini donanımınıza ve iş yükünüze göre özelleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте рівні активності системи відповідно до обладнання й навантаження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے ہارڈویئر اور کام کے بوجھ کے مطابق سسٹم کی سرگرمی کی سطحیں مقرر کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chỉnh mức hoạt động hệ thống cho phần cứng và khối lượng công việc."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依硬體與工作負載自訂系統活動等級。"
          }
        }
