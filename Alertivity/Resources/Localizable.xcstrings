  "pro.unavailable": {
    "comment": "AL-79: App Store Pro customization and purchase UI.",
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro is currently unavailable for purchase. You can still restore an existing purchase."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro kann derzeit nicht gekauft werden. Vorhandene Käufe können weiterhin wiederhergestellt werden."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro n’est pas disponible à l’achat pour le moment. Vous pouvez toujours restaurer un achat existant."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "現在 Pro を購入できません。購入済みの場合は復元できます。"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro 暂时无法购买。您仍可恢复已有购买。"
        }
      }
    }
  },
  "pro.loadError": {
    "comment": "AL-79: App Store Pro customization and purchase UI.",
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Couldn’t load purchase options. Please try again."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Kaufoptionen konnten nicht geladen werden. Bitte versuche es erneut."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Impossible de charger les options d’achat. Réessayez."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "購入オプションを読み込めませんでした。もう一度お試しください。"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "无法加载购买选项，请重试。"
        }
      }
    }
  },
  "pro.pending": {
    "comment": "AL-79: App Store Pro customization and purchase UI.",
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Your purchase is awaiting approval. Pro will unlock when it is approved."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Dein Kauf wartet auf Genehmigung. Pro wird nach der Genehmigung freigeschaltet."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Votre achat est en attente d’approbation. Pro sera déverrouillé après son approbation."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "購入の承認を待っています。承認されると Pro が有効になります。"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "购买正在等待批准，批准后将自动解锁 Pro。"
        }
      }
    }
  },
  "pro.purchaseError": {
