        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varnar efter %d s med kritisk aktivitet, med minst %@ mellan varningarna. Inkluderar processer med hög aktivitet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தீவிரச் செயல்பாடு %1$d வினாடிகள் நீடித்தால், குறைந்தது %2$@ இடைவெளியில் விழிப்பூட்டும். அதிகச் செயல்பாட்டுச் செயல்முறைகளும் அடங்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d సెకన్ల తీవ్ర కార్యకలాపం తర్వాత, కనీసం %2$@ విరామంతో హెచ్చరిస్తుంది. అధిక కార్యకలాప ప్రాసెస్‌లు కూడా ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
