        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମେମୋରି ସୀମାରେ ବ୍ୟବହୃତ ଭୌତିକ ମେମୋରିର ଶତକଡ଼ା ଧରାଯାଏ।"
