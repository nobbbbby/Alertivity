    "settings.menuBar.autoSwitch.help" : {
      "localizations" : {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto switch follows the selected activation level and metric priority, then returns to the default icon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisches Umschalten folgt der gewählten Aktivierungsstufe und Metrikpriorität und kehrt dann zum Standardsymbol zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le basculement suit le niveau d’activation et la priorité choisis, puis revient à l’icône par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した開始レベルと指標の優先順位に従って切り替え、その後既定のアイコンに戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动切换遵循所选激活级别和指标优先级，随后返回默认图标。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع التبديل التلقائي مستوى التنشيط وأولوية المقاييس المحددين، ثم يعود إلى الأيقونة الافتراضية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অটো সুইচ বাছাই করা সক্রিয়করণ স্তর ও মেট্রিকের অগ্রাধিকার মেনে চলে, তারপর ডিফল্ট আইকনে ফিরে আসে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El canvi automàtic segueix el nivell d’activació i la prioritat de les mètriques seleccionats, i després torna a la icona predeterminada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatické přepínání se řídí vybranou úrovní aktivace a prioritou metrik, poté se vrátí k výchozí ikoně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk skift følger det valgte aktiveringsniveau og metrikprioriteten og vender derefter tilbage til standardsymbolet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αυτόματη εναλλαγή ακολουθεί το επιλεγμένο επίπεδο ενεργοποίησης και την προτεραιότητα μετρήσεων και επιστρέφει στο προεπιλεγμένο εικονίδιο."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto switch follows the selected activation level and metric priority, then returns to the default icon."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto switch follows the selected activation level and metric priority, then returns to the default icon."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto switch follows the selected activation level and metric priority, then returns to the default icon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio automático sigue el nivel de activación y la prioridad de métricas seleccionados, y después vuelve al icono predeterminado."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio automático sigue el nivel de activación y la prioridad de métricas seleccionados, y después vuelve al icono predeterminado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattinen vaihto seuraa valittua aktivointitasoa ja mittareiden tärkeysjärjestystä ja palaa sitten oletuskuvakkeeseen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le basculement automatique suit le niveau d’activation et la priorité des métriques sélectionnés, puis revient à l’icône par défaut."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આપમેળે બદલવું પસંદ કરેલા સક્રિયકરણ સ્તર અને માપદંડની પ્રાથમિકતા અનુસરે છે, પછી ડિફૉલ્ટ આઇકન પર પાછું ફરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המעבר האוטומטי פועל לפי רמת ההפעלה ועדיפות המדדים שנבחרו, ואז חוזר לאייקון ברירת המחדל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑटो स्विच चुने गए सक्रियण स्तर और मेट्रिक प्राथमिकता के अनुसार चलता है, फिर डिफ़ॉल्ट आइकॉन पर लौटता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatsko prebacivanje slijedi odabranu razinu aktivacije i prioritet mjernih podataka, a zatim se vraća na zadanu ikonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az automatikus váltás a kiválasztott aktiválási szintet és a mérőszámok prioritását követi, majd visszatér az alapértelmezett ikonhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengalihan otomatis mengikuti tingkat aktivasi dan prioritas metrik yang dipilih, lalu kembali ke ikon default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cambio automatico segue il livello di attivazione e la priorità delle metriche selezionati, poi torna all’icona predefinita."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವಯಂ ಬದಲಾವಣೆಯು ಆಯ್ದ ಸಕ್ರಿಯಗೊಳಿಸುವ ಮಟ್ಟ ಮತ್ತು ಮಾಪನ ಆದ್ಯತೆಯನ್ನು ಅನುಸರಿಸಿ, ನಂತರ ಡೀಫಾಲ್ಟ್ ಐಕಾನ್‌ಗೆ ಮರಳುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 전환은 선택한 활성화 수준과 지표 우선순위를 따르며 이후 기본 아이콘으로 돌아갑니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓട്ടോ സ്വിച്ച് തിരഞ്ഞെടുത്ത സജീവമാക്കൽ നിലയും മെട്രിക്ക് മുൻഗണനയും പിന്തുടർന്ന് ഡിഫോൾട്ട് ഐക്കണിലേക്ക് മടങ്ങുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आपोआप बदल निवडलेल्या सक्रियता पातळीनुसार आणि मेट्रिक प्राधान्यक्रमानुसार होतो, नंतर डीफॉल्ट चिन्हावर परततो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertukaran automatik mengikut tahap pengaktifan dan keutamaan metrik yang dipilih, kemudian kembali kepada ikon lalai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk bytte følger valgt aktiveringsnivå og måleprioritet, og går deretter tilbake til standardsymbolet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch schakelen volgt het gekozen activeringsniveau en de metriekprioriteit en keert daarna terug naar het standaardsymbool."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସ୍ୱୟଂଚାଳିତ ବଦଳ ବଛା ସକ୍ରିୟକରଣ ସ୍ତର ଓ ମାପକ ପ୍ରାଥମିକତା ଅନୁସରଣ କରି ପରେ ଡିଫଲ୍ଟ ଆଇକନ୍‌କୁ ଫେରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਟੋ ਸਵਿੱਚ ਚਾਲੂ ਹੋਣ ਲਈ ਚੁਣੇ ਪੱਧਰ ਅਤੇ ਮੈਟ੍ਰਿਕ ਤਰਜੀਹ ਅਨੁਸਾਰ ਚੱਲਦਾ ਹੈ, ਫਿਰ ਡਿਫ਼ੌਲਟ ਆਈਕਨ ’ਤੇ ਵਾਪਸ ਆਉਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczne przełączanie uwzględnia wybrany poziom aktywacji i priorytet wskaźników, a następnie wraca do domyślnej ikony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A alternância automática segue o nível de ativação e a prioridade de métricas selecionados e depois volta ao ícone padrão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A alternância automática segue o nível de ativação e a prioridade de métricas selecionados e depois volta ao ícone predefinido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comutarea automată urmează nivelul de activare și prioritatea indicatorilor selectate, apoi revine la pictograma implicită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автопереключение учитывает выбранный уровень активации и приоритет показателей, затем возвращается к стандартному значку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatické prepínanie sa riadi vybranou úrovňou aktivácie a prioritou metrík, potom sa vráti k predvolenej ikone."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samodejno preklapljanje sledi izbrani ravni aktivacije in prednosti meritev, nato pa se vrne na privzeto ikono."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatiskt byte följer vald aktiveringsnivå och mätvärdesprioritet och återgår sedan till standardsymbolen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தானியங்கி மாற்றம் தேர்ந்தெடுத்த செயல்படுத்தும் நிலையையும் அளவீட்டு முன்னுரிமையையும் பின்பற்றி, பின்னர் இயல்புநிலை ஐகானுக்குத் திரும்பும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆటో స్విచ్ ఎంచుకున్న ప్రారంభ స్థాయి, కొలమానం ప్రాధాన్యతను అనుసరించి, తర్వాత డిఫాల్ట్ ఐకాన్‌కు తిరిగి వస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสลับอัตโนมัติจะใช้ระดับการเริ่มทำงานและลำดับความสำคัญของตัววัดที่เลือก แล้วกลับไปใช้ไอคอนเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik geçiş, seçilen etkinleştirme düzeyini ve ölçüm önceliğini izler, ardından saptanmış simgeye döner."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоперемикання враховує вибраний рівень активації та пріоритет показників, а потім повертається до типової іконки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خودکار تبدیلی منتخب فعالی سطح اور پیمانوں کی ترجیح کے مطابق ہوتی ہے، پھر پہلے سے طے شدہ آئیکن پر لوٹتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển tự động tuân theo mức kích hoạt và ưu tiên chỉ số đã chọn, rồi trở về biểu tượng mặc định."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動切換會依照所選的啟用等級和指標優先順序運作，然後回到預設圖像。"
          }
        }
      }
    },
