    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Your purchase is awaiting approval. Pro will unlock when it is approved."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Dein Kauf wartet auf Genehmigung. Pro wird nach der Genehmigung freigeschaltet."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Votre achat est en attente d’approbation. Pro sera déverrouillé après son approbation."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "購入の承認を待っています。承認されると Pro が有効になります。"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "购买正在等待批准，批准后将自动解锁 Pro。"
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "عملية الشراء بانتظار الموافقة. سيُفتح قفل Pro عند الموافقة عليها."
        }
      },
      "bn": {
        "stringUnit": {
          "state": "translated",
          "value": "আপনার কেনাকাটা অনুমোদনের অপেক্ষায় আছে। অনুমোদন পেলে Pro আনলক হবে।"
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "La compra està pendent d’aprovació. El Pro es desbloquejarà quan s’aprovi."
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Nákup čeká na schválení. Po schválení se Pro odemkne."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Dit køb afventer godkendelse. Pro låses op, når det er godkendt."
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Η αγορά σας αναμένει έγκριση. Το Pro θα ξεκλειδωθεί μόλις εγκριθεί."
        }
      },
      "en-AU": {
        "stringUnit": {
          "state": "translated",
          "value": "Your purchase is awaiting approval. Pro will unlock when it is approved."
        }
      },
      "en-CA": {
        "stringUnit": {
          "state": "translated",
          "value": "Your purchase is awaiting approval. Pro will unlock when it is approved."
        }
      },
      "en-GB": {
        "stringUnit": {
          "state": "translated",
          "value": "Your purchase is awaiting approval. Pro will unlock when it is approved."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Tu compra está pendiente de aprobación. Pro se desbloqueará cuando se apruebe."
        }
      },
      "es-MX": {
        "stringUnit": {
          "state": "translated",
          "value": "Tu compra está pendiente de aprobación. Pro se desbloqueará cuando se apruebe."
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Ostoksesi odottaa hyväksyntää. Pro avautuu hyväksynnän jälkeen."
        }
      },
      "fr-CA": {
        "stringUnit": {
          "state": "translated",
          "value": "Votre achat est en attente d’approbation. Pro sera déverrouillé après son approbation."
        }
      },
      "gu": {
        "stringUnit": {
          "state": "translated",
          "value": "તમારી ખરીદી મંજૂરીની રાહ જુએ છે. મંજૂર થતાં Pro અનલૉક થશે."
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "הרכישה ממתינה לאישור. הגישה ל-Pro תיפתח לאחר האישור."
        }
      },
      "hi": {
        "stringUnit": {
          "state": "translated",
          "value": "आपकी ख़रीदारी मंज़ूरी की प्रतीक्षा में है। मंज़ूरी मिलने पर Pro अनलॉक हो जाएगा।"
        }
      },
      "hr": {
        "stringUnit": {
          "state": "translated",
          "value": "Kupnja čeka odobrenje. Pro će se otključati nakon odobrenja."
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "A vásárlás jóváhagyásra vár. A Pro jóváhagyás után oldódik fel."
        }
      },
      "id": {
        "stringUnit": {
          "state": "translated",
          "value": "Pembelian Anda menunggu persetujuan. Pro akan terbuka setelah disetujui."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Il tuo acquisto è in attesa di approvazione. Pro si sbloccherà dopo l’approvazione."
        }
      },
      "kn": {
        "stringUnit": {
          "state": "translated",
          "value": "ನಿಮ್ಮ ಖರೀದಿ ಅನುಮೋದನೆಗಾಗಿ ಕಾಯುತ್ತಿದೆ. ಅನುಮೋದನೆಯಾದಾಗ Pro ಅನ್‌ಲಾಕ್ ಆಗುತ್ತದೆ."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "구매 승인을 기다리는 중입니다. 승인되면 Pro가 잠금 해제됩니다."
        }
      },
      "ml": {
        "stringUnit": {
          "state": "translated",
          "value": "നിങ്ങളുടെ വാങ്ങൽ അംഗീകാരത്തിനായി കാത്തിരിക്കുന്നു. അംഗീകരിക്കുമ്പോൾ Pro അൺലോക്ക് ചെയ്യും."
        }
      },
      "mr": {
        "stringUnit": {
          "state": "translated",
          "value": "तुमची खरेदी मंजुरीच्या प्रतीक्षेत आहे. मंजुरी मिळाल्यावर Pro अनलॉक होईल."
        }
      },
      "ms": {
        "stringUnit": {
          "state": "translated",
          "value": "Pembelian anda menunggu kelulusan. Pro akan dibuka kunci setelah diluluskan."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Kjøpet ditt venter på godkjenning. Pro låses opp når det blir godkjent."
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "Je aankoop wacht op goedkeuring. Pro wordt ontgrendeld na goedkeuring."
        }
      },
      "or": {
        "stringUnit": {
          "state": "translated",
          "value": "ଆପଣଙ୍କ କ୍ରୟ ଅନୁମୋଦନ ଅପେକ୍ଷାରେ ଅଛି। ଅନୁମୋଦନ ପରେ Pro ଅନଲକ୍ ହେବ।"
        }
      },
      "pa": {
        "stringUnit": {
          "state": "translated",
          "value": "ਤੁਹਾਡੀ ਖ਼ਰੀਦ ਮਨਜ਼ੂਰੀ ਦੀ ਉਡੀਕ ਵਿੱਚ ਹੈ। ਮਨਜ਼ੂਰੀ ਮਿਲਣ ਉੱਤੇ Pro ਅਨਲੌਕ ਹੋ ਜਾਵੇਗਾ।"
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Zakup oczekuje na zatwierdzenie. Pro zostanie odblokowane po zatwierdzeniu."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Sua compra aguarda aprovação. O Pro será desbloqueado quando ela for aprovada."
        }
      },
      "pt-PT": {
        "stringUnit": {
          "state": "translated",
          "value": "Sua compra aguarda aprovação. O Pro será desbloqueado quando ela for aprovada."
        }
      },
      "ro": {
        "stringUnit": {
          "state": "translated",
          "value": "Achiziția așteaptă aprobarea. Pro se va debloca după aprobare."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Покупка ожидает одобрения. После одобрения Pro будет разблокирован."
        }
      },
      "sk": {
        "stringUnit": {
          "state": "translated",
          "value": "Nákup čaká na schválenie. Po schválení sa Pro odomkne."
        }
      },
      "sl": {
        "stringUnit": {
          "state": "translated",
          "value": "Nakup čaka na odobritev. Pro se bo odklenil po odobritvi."
        }
      },
      "sv": {
        "stringUnit": {
          "state": "translated",
          "value": "Ditt köp väntar på godkännande. Pro låses upp när det godkänns."
        }
      },
      "ta": {
        "stringUnit": {
          "state": "translated",
          "value": "உங்கள் கொள்முதல் ஒப்புதலுக்குக் காத்திருக்கிறது. ஒப்புதல் கிடைத்ததும் Pro திறக்கப்படும்."
        }
      },
      "te": {
        "stringUnit": {
          "state": "translated",
          "value": "మీ కొనుగోలు ఆమోదం కోసం వేచి ఉంది. ఆమోదం పొందినప్పుడు Pro అన్‌లాక్ అవుతుంది."
        }
      },
      "th": {
        "stringUnit": {
          "state": "translated",
          "value": "รายการซื้อกำลังรอการอนุมัติ Pro จะปลดล็อคเมื่อได้รับอนุมัติ"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Satın alımınız onay bekliyor. Onaylandığında Pro’nun kilidi açılacak."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Покупка очікує схвалення. Після схвалення Pro буде розблоковано."
        }
      },
      "ur": {
        "stringUnit": {
          "state": "translated",
          "value": "آپ کی خریداری منظوری کی منتظر ہے۔ منظوری کے بعد Pro کھل جائے گا۔"
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Giao dịch mua đang chờ phê duyệt. Pro sẽ được mở khóa khi được phê duyệt."
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "購買項目正在等待核准。核准後即可解鎖 Pro。"
        }
      }
    }
  },
  "pro.purchaseError": {
