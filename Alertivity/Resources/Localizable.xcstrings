        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg når indikatoren vises og hva den viser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies wanneer de indicator verschijnt en wat deze toont."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସୂଚକ କେବେ ଓ କ’ଣ ଦେଖାଇବ ତାହା ବାଛନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
