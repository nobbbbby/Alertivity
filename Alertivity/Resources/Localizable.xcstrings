    "onboarding.login.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls macOS eine Bestätigung verlangt, erlaube Alertivity unter Systemeinstellungen → Allgemein → Anmeldeobjekte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If macOS requires approval, open System Settings → General → Login Items to allow Alertivity."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si macOS demande une approbation, autorisez Alertivity dans Réglages Système → Général → Ouverture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSで承認が必要な場合は、システム設定 → 一般 → ログイン項目でAlertivityを許可してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如 macOS 要求批准，请前往“系统设置”→“通用”→“登录项”允许 Alertivity。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا تطلب macOS موافقة، يرجى فتح إعدادات النظام → عام → عناصر الدخول للسماح بتشغيل Alertivity."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS অনুমোদন চাইলে সিস্টেম সেটিংস → সাধারণ → লগইন আইটেম খুলে Alertivity-কে অনুমতি দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el macOS demana aprovació, obre Configuració del Sistema → General → Ítems d’inici de sessió per permetre l’Alertivity."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud macOS vyžaduje schválení, povolte Alertivity v Nastavení systému → Obecné → Přihlášení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis macOS kræver godkendelse, skal du åbne Systemindstillinger → Generelt → Loginemner for at tillade Alertivity."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν το macOS απαιτεί έγκριση, ανοίξτε Ρυθμίσεις συστήματος → Γενικά → Στοιχεία σύνδεσης για να επιτρέψετε το Alertivity."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If macOS requires approval, open System Settings → General → Login Items to allow Alertivity."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "If macOS requires approval, open System Settings → General → Login Items to allow Alertivity."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If macOS requires approval, open System Settings → General → Login Items to allow Alertivity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si macOS requiere aprobación, abre Ajustes del Sistema → General → Ítems de inicio para permitir Alertivity."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si macOS requiere aprobación, abre Configuración del Sistema → General → Ítems de inicio para permitir Alertivity."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos macOS vaatii hyväksynnän, salli Alertivity kohdassa Järjestelmäasetukset → Yleiset → Kirjautumiskohteet."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si macOS demande une approbation, autorisez Alertivity dans Réglages système → Général → Ouverture."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS મંજૂરી માંગે તો સિસ્ટમ સેટિંગ્સ → સામાન્ય → લૉગિન આઇટમ્સ ખોલીને Alertivity ને મંજૂરી આપો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם macOS דורש אישור, יש לפתוח את הגדרות המערכת → כללי → פריטי התחברות ולאפשר את Alertivity."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर macOS मंज़ूरी माँगता है, तो Alertivity को अनुमति देने के लिए सिस्टम सेटिंग्ज़ → सामान्य → लॉगिन आइटम खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako macOS zahtijeva odobrenje, dopusti Alertivity u odjeljku Postavke sustava → Općenito → Stavke za prijavu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a macOS jóváhagyást kér, engedélyezze az Alertivityt a Rendszerbeállítások → Általános → Bejelentkezési elemek részen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika macOS memerlukan persetujuan, buka Pengaturan Sistem → Umum → Item Masuk untuk mengizinkan Alertivity."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se macOS richiede l’approvazione, apri Impostazioni di Sistema → Generali → Elementi login per consentire Alertivity."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ಅನುಮೋದನೆ ಕೇಳಿದರೆ ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್ಸ್ → ಸಾಮಾನ್ಯ → ಲಾಗಿನ್ ಐಟಂಗಳನ್ನು ತೆರೆದು Alertivity ಗೆ ಅನುಮತಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 승인이 필요한 경우 시스템 설정 → 일반 → 로그인 항목에서 Alertivity를 허용하십시오."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS അംഗീകാരം ആവശ്യപ്പെട്ടാൽ സിസ്റ്റം ക്രമീകരണം → പൊതുവായത് → ലോഗിൻ ഇനങ്ങൾ തുറന്ന് Alertivity അനുവദിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ने मंजुरी मागितल्यास Alertivity ला परवानगी देण्यासाठी सिस्टम सेटिंग्ज → सामान्य → लॉगिन आयटम उघडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika macOS memerlukan kelulusan, buka Seting Sistem → Umum → Item Log Masuk untuk membenarkan Alertivity."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis macOS krever godkjenning, åpner du Systeminnstillinger → Generelt → Påloggingsobjekter for å tillate Alertivity."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als macOS goedkeuring vereist, open je Systeeminstellingen → Algemeen → Inloggen om Alertivity toe te staan."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ଅନୁମୋଦନ ମାଗିଲେ ସିଷ୍ଟମ୍ ସେଟିଂସ୍ → ସାଧାରଣ → ଲଗଇନ୍ ଆଇଟମ୍ ଖୋଲି Alertivity କୁ ଅନୁମତି ଦିଅନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੇ macOS ਮਨਜ਼ੂਰੀ ਮੰਗਦਾ ਹੈ, ਤਾਂ Alertivity ਨੂੰ ਇਜਾਜ਼ਤ ਦੇਣ ਲਈ ਸਿਸਟਮ ਸੈਟਿੰਗਾਂ → ਆਮ → ਲੌਗਇਨ ਆਈਟਮ ਖੋਲ੍ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli macOS wymaga zgody, zezwól na Alertivity w sekcji Ustawienia systemowe → Ogólne → Rzeczy do otwarcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o macOS exigir aprovação, abra Ajustes do Sistema → Geral → Itens de Início para permitir o Alertivity."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o macOS exigir aprovação, abra Definições do Sistema → Geral → Elementos de início de sessão para permitir o Alertivity."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă macOS necesită aprobare, permite Alertivity în Configurări sistem → General → Articole de login."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если macOS требует одобрения, откройте Системные настройки → Основные → Объекты входа и разрешите Alertivity."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak macOS vyžaduje schválenie, povoľte Alertivity v časti Systémové nastavenia → Všeobecné → Prihlasovacie položky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če macOS zahteva odobritev, dovoli Alertivity v razdelku Nastavitve sistema → Splošno → Prijavni elementi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om macOS kräver godkännande öppnar du Systeminställningar → Allmänt → Inloggningsobjekt för att tillåta Alertivity."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ஒப்புதல் கேட்டால், கணினி அமைப்புகள் → பொதுவானவை → உள்நுழைவு உருப்படிகள் சென்று Alertivity க்கு அனுமதி அளிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ఆమోదం కోరితే సిస్టమ్ సెట్టింగ్స్ → సాధారణం → లాగిన్ అంశాలు తెరిచి Alertivity కి అనుమతించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หาก macOS ต้องการการอนุมัติ ให้เปิดการตั้งค่าระบบ → ทั่วไป → รายการเข้าสู่ระบบเพื่ออนุญาต Alertivity"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS onay gerektiriyorsa Alertivity’ye izin vermek için Sistem Ayarları → Genel → Giriş Öğeleri bölümünü açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо macOS потребує схвалення, відкрийте Системні параметри → Загальні → Елементи входу та дозвольте Alertivity."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر macOS منظوری مانگے تو سسٹم کی ترتیبات ← عمومی ← لاگ ان آئٹمز کھول کر Alertivity کی اجازت دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu macOS yêu cầu phê duyệt, mở Cài đặt hệ thống → Cài đặt chung → Mục đăng nhập để cho phép Alertivity."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若 macOS 要求授權，請開啟「系統設定」→「一般」→「登入項目」來允許 Alertivity。"
          }
        }
      }
    },
