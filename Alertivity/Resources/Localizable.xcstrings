      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Du kannst Pro jederzeit unter Einstellungen → Pro freischalten."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Vous pouvez déverrouiller Pro à tout moment dans Réglages → Pro."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "「設定 → Pro」からいつでも Pro を購入できます。"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "您可随时在“设置 → Pro”中解锁。"
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "يمكن فتح قفل Pro في أي وقت من الإعدادات → Pro."
        }
      },
      "bn": {
        "stringUnit": {
          "state": "translated",
          "value": "যেকোনও সময় সেটিংস → Pro থেকে Pro আনলক করতে পারেন।"
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "Pots desbloquejar el Pro quan vulguis a Configuració → Pro."
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro můžete kdykoli odemknout v Nastavení → Pro."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Du kan altid låse Pro op i Indstillinger → Pro."
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Μπορείτε να ξεκλειδώσετε το Pro στις Ρυθμίσεις → Pro οποιαδήποτε στιγμή."
        }
      },
      "en-AU": {
        "stringUnit": {
          "state": "translated",
          "value": "You can unlock Pro anytime in Settings → Pro."
        }
      },
      "en-CA": {
        "stringUnit": {
          "state": "translated",
          "value": "You can unlock Pro anytime in Settings → Pro."
        }
      },
      "en-GB": {
        "stringUnit": {
          "state": "translated",
          "value": "You can unlock Pro anytime in Settings → Pro."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Puedes desbloquear Pro en cualquier momento en Ajustes → Pro."
        }
      },
      "es-MX": {
        "stringUnit": {
          "state": "translated",
          "value": "Puedes desbloquear Pro en cualquier momento en Configuración → Pro."
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Voit avata Pron milloin tahansa kohdassa Asetukset → Pro."
        }
      },
      "fr-CA": {
        "stringUnit": {
          "state": "translated",
          "value": "Vous pouvez déverrouiller Pro à tout moment dans Réglages → Pro."
        }
      },
      "gu": {
        "stringUnit": {
          "state": "translated",
          "value": "સેટિંગ્સ → Pro માં ગમે ત્યારે Pro અનલૉક કરી શકો છો."
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "ניתן לפתוח את Pro בכל עת בהגדרות → Pro."
        }
      },
      "hi": {
        "stringUnit": {
          "state": "translated",
          "value": "आप सेटिंग्ज़ → Pro में कभी भी Pro अनलॉक कर सकते हैं।"
        }
      },
      "hr": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro možeš otključati bilo kada u odjeljku Postavke → Pro."
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "A Pro bármikor feloldható a Beállítások → Pro részen."
        }
      },
      "id": {
        "stringUnit": {
          "state": "translated",
          "value": "Anda dapat membuka Pro kapan saja di Pengaturan → Pro."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Puoi sbloccare Pro in qualsiasi momento in Impostazioni → Pro."
        }
      },
      "kn": {
        "stringUnit": {
          "state": "translated",
          "value": "ಸೆಟ್ಟಿಂಗ್ಸ್ → Pro ನಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ Pro ಅನ್‌ಲಾಕ್ ಮಾಡಬಹುದು."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "언제든지 설정 → Pro에서 Pro를 잠금 해제할 수 있습니다."
        }
      },
      "ml": {
        "stringUnit": {
          "state": "translated",
          "value": "ക്രമീകരണം → Pro വഴി എപ്പോൾ വേണമെങ്കിലും Pro അൺലോക്ക് ചെയ്യാം."
        }
      },
      "mr": {
        "stringUnit": {
          "state": "translated",
          "value": "तुम्ही सेटिंग्ज → Pro मध्ये कधीही Pro अनलॉक करू शकता."
        }
      },
      "ms": {
        "stringUnit": {
          "state": "translated",
          "value": "Anda boleh membuka kunci Pro pada bila-bila masa dalam Seting → Pro."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Du kan låse opp Pro når som helst i Innstillinger → Pro."
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "Je kunt Pro altijd ontgrendelen in Instellingen → Pro."
        }
      },
      "or": {
        "stringUnit": {
          "state": "translated",
          "value": "ସେଟିଂସ୍ → Pro ରେ ଯେକୌଣସି ସମୟରେ Pro ଅନଲକ୍ କରିପାରିବେ।"
        }
      },
      "pa": {
        "stringUnit": {
          "state": "translated",
          "value": "ਤੁਸੀਂ ਸੈਟਿੰਗਾਂ → Pro ਵਿੱਚ ਕਿਸੇ ਵੀ ਸਮੇਂ Pro ਅਨਲੌਕ ਕਰ ਸਕਦੇ ਹੋ।"
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Możesz odblokować Pro w dowolnej chwili w sekcji Ustawienia → Pro."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Você pode desbloquear o Pro a qualquer momento em Ajustes → Pro."
        }
      },
      "pt-PT": {
        "stringUnit": {
          "state": "translated",
          "value": "Pode desbloquear o Pro a qualquer momento em Definições → Pro."
        }
      },
      "ro": {
        "stringUnit": {
          "state": "translated",
          "value": "Poți debloca Pro oricând în Configurări → Pro."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Разблокировать Pro можно в любое время в Настройках → Pro."
        }
      },
      "sk": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro môžete kedykoľvek odomknúť v časti Nastavenia → Pro."
        }
      },
      "sl": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro lahko kadar koli odkleneš v razdelku Nastavitve → Pro."
        }
      },
      "sv": {
        "stringUnit": {
          "state": "translated",
          "value": "Du kan låsa upp Pro när som helst i Inställningar → Pro."
        }
      },
      "ta": {
        "stringUnit": {
          "state": "translated",
          "value": "அமைப்புகள் → Pro இல் எப்போது வேண்டுமானாலும் Pro ஐத் திறக்கலாம்."
        }
      },
      "te": {
        "stringUnit": {
          "state": "translated",
          "value": "సెట్టింగ్స్ → Pro లో ఎప్పుడైనా Pro అన్‌లాక్ చేయవచ్చు."
        }
      },
      "th": {
        "stringUnit": {
          "state": "translated",
          "value": "ปลดล็อค Pro ได้ทุกเมื่อในการตั้งค่า → Pro"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Ayarlar → Pro bölümünden istediğiniz zaman Pro’nun kilidini açabilirsiniz."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Розблокувати Pro можна будь-коли в Параметрах → Pro."
        }
      },
      "ur": {
        "stringUnit": {
          "state": "translated",
          "value": "کسی بھی وقت ترتیبات ← Pro میں Pro کھول سکتے ہیں۔"
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Bạn có thể mở khóa Pro bất kỳ lúc nào trong Cài đặt → Pro."
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "隨時可在「設定」→ Pro 解鎖 Pro。"
        }
      }
    }
  },
