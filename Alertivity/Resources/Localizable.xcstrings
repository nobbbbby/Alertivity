        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en app eller körbar fil att undanta från övervakning av processer med hög aktivitet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிகச் செயல்பாட்டுச் செயல்முறைக் கண்காணிப்பிலிருந்து விலக்கச் செயலியையோ இயக்கக்கூடிய கோப்பையோ தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అధిక కార్యకలాప ప్రాసెస్ పర్యవేక్షణ నుండి మినహాయించడానికి యాప్ లేదా ఎగ్జిక్యూటబుల్ ఎంచుకోండి."
          }
