    "settings.notifications.cooldown.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimum time between activity notifications. Applies to all system and process alerts."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestabstand zwischen Aktivitätsbenachrichtigungen. Gilt für alle System- und Prozesswarnungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délai minimum entre les notifications d’activité. S’applique à toutes les alertes système et de processus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティビティ通知の最小間隔です。すべてのシステム通知とプロセス通知に適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活动通知之间的最短间隔，适用于所有系统和进程提醒。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد الأدنى للوقت بين إشعارات النشاط. ينطبق على جميع تنبيهات النظام والعمليات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাক্টিভিটির নোটিফিকেশনের মধ্যে ন্যূনতম সময়। সব সিস্টেম ও প্রসেসের সতর্কতায় প্রযোজ্য।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps mínim entre notificacions d’activitat. S’aplica a tots els avisos del sistema i dels processos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimální doba mezi oznámeními aktivity. Platí pro všechna systémová i procesová upozornění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindste tid mellem aktivitetsnotifikationer. Gælder alle system- og procesadvarsler."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελάχιστος χρόνος μεταξύ ειδοποιήσεων δραστηριότητας. Ισχύει για όλες τις ειδοποιήσεις συστήματος και διεργασιών."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum time between activity notifications. Applies to all system and process alerts."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum time between activity notifications. Applies to all system and process alerts."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum time between activity notifications. Applies to all system and process alerts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo mínimo entre notificaciones de actividad. Se aplica a todas las alertas del sistema y de procesos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo mínimo entre notificaciones de actividad. Se aplica a todas las alertas del sistema y de procesos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitusten välinen vähimmäisaika. Koskee kaikkia järjestelmän ja prosessien aktiivisuusilmoituksia."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai minimum entre les notifications d’activité. S’applique à toutes les alertes système et de processus."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્રવૃત્તિની સૂચનાઓ વચ્ચેનો લઘુત્તમ સમય. સિસ્ટમ અને પ્રક્રિયાની બધી ચેતવણીઓને લાગુ પડે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזמן המזערי בין עדכוני פעילות. חל על כל התראות המערכת והתהליכים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गतिविधि की सूचनाओं के बीच न्यूनतम समय। सभी सिस्टम और प्रोसेस अलर्ट पर लागू होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najkraće vrijeme između obavijesti o aktivnosti. Vrijedi za sva upozorenja sustava i procesa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az aktivitási értesítések közötti legrövidebb idő. Minden rendszer- és folyamatriasztásra érvényes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu minimum antar notifikasi aktivitas. Berlaku untuk semua peringatan sistem dan proses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo minimo tra le notifiche di attività. Si applica a tutti gli avvisi di sistema e dei processi."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚಟುವಟಿಕೆ ಸೂಚನೆಗಳ ನಡುವಿನ ಕನಿಷ್ಠ ಸಮಯ. ಎಲ್ಲಾ ಸಿಸ್ಟಂ ಮತ್ತು ಪ್ರಕ್ರಿಯೆ ಎಚ್ಚರಿಕೆಗಳಿಗೆ ಅನ್ವಯಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활동 알림 사이의 최소 시간입니다. 모든 시스템 및 프로세스 알림에 적용됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആക്റ്റിവിറ്റി അറിയിപ്പുകൾക്കിടയിലെ കുറഞ്ഞ സമയം. എല്ലാ സിസ്റ്റം, പ്രോസസ് മുന്നറിയിപ്പുകൾക്കും ബാധകം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ॲक्टिव्हिटीच्या सूचनांमधील किमान वेळ. सर्व सिस्टम आणि प्रक्रिया सूचनांना लागू होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa minimum antara pemberitahuan aktiviti. Digunakan untuk semua amaran sistem dan proses."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Minste tid mellom aktivitetsvarslinger. Gjelder alle system- og prosessvarsler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimale tijd tussen activiteitsmeldingen. Geldt voor alle systeem- en proceswaarschuwingen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କାର୍ଯ୍ୟକଳାପ ସୂଚନା ମଧ୍ୟରେ ସର୍ବନିମ୍ନ ସମୟ। ସବୁ ସିଷ୍ଟମ୍ ଓ ପ୍ରୋସେସ୍ ଚେତାବନୀରେ ଲାଗୁ ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਰਗਰਮੀ ਦੀਆਂ ਸੂਚਨਾਵਾਂ ਵਿਚਕਾਰ ਘੱਟੋ-ਘੱਟ ਸਮਾਂ। ਸਾਰੇ ਸਿਸਟਮ ਅਤੇ ਪ੍ਰੋਸੈੱਸ ਅਲਰਟ ਉੱਤੇ ਲਾਗੂ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimalny czas między powiadomieniami o aktywności. Dotyczy wszystkich alertów systemu i procesów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo mínimo entre notificações de atividade. Aplica-se a todos os alertas do sistema e de processos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo mínimo entre notificações de atividade. Aplica-se a todos os alertas do sistema e de processos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Timpul minim între notificările de activitate. Se aplică tuturor alertelor de sistem și de procese."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минимальное время между уведомлениями об активности. Применяется ко всем предупреждениям системы и процессов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimálny čas medzi hláseniami o aktivite. Platí pre všetky systémové aj procesové upozornenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najkrajši čas med obvestili o dejavnosti. Velja za vsa sistemska in procesna opozorila."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minsta tid mellan aktivitetsnotiser. Gäller alla system- och processvarningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயல்பாட்டு அறிவிப்புகளுக்கிடையிலான குறைந்தபட்ச நேரம். எல்லாக் கணினி மற்றும் செயல்முறை விழிப்பூட்டல்களுக்கும் பொருந்தும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కార్యకలాప నోటిఫికేషన్‌ల మధ్య కనీస సమయం. అన్ని సిస్టమ్, ప్రాసెస్ హెచ్చరికలకు వర్తిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาขั้นต่ำระหว่างการแจ้งเตือนกิจกรรม ใช้กับการแจ้งเตือนระบบและกระบวนการทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinlik bildirimleri arasındaki en az süre. Tüm sistem ve işlem uyarıları için geçerlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мінімальний час між сповіщеннями про активність. Стосується всіх попереджень системи й процесів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرگرمی کی اطلاعات کے درمیان کم از کم وقت۔ سسٹم اور پراسیس کی تمام اطلاعات پر لاگو ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian tối thiểu giữa các thông báo hoạt động. Áp dụng cho mọi cảnh báo hệ thống và tiến trình."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "活動通知之間的最短間隔。適用於所有系統和程序通知。"
          }
        }
      }
    },
