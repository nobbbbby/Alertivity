    "onboarding.notifications.denied.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle in den Systemeinstellungen Mitteilungen → Alertivity und aktiviere Mitteilungen erlauben. Kehre hierher zurück, um den Status zu aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In System Settings, choose Notifications → Alertivity and turn on Allow Notifications. Return here to refresh the status."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Réglages Système, choisissez Notifications → Alertivity et activez Autoriser les notifications. Revenez ici pour actualiser l’état."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定で「通知」→「Alertivity」を選び、通知を許可してください。ここに戻ると状態が更新されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“系统设置”中选择“通知”→“Alertivity”，开启“允许通知”。返回此处后会刷新状态。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في إعدادات النظام، يرجى اختيار الإشعارات → Alertivity وتشغيل السماح بالإشعارات. يمكن العودة إلى هنا لتحديث الحالة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম সেটিংসে নোটিফিকেশন → Alertivity বেছে নিয়ে নোটিফিকেশনের অনুমতি চালু করুন। স্ট্যাটাস রিফ্রেশ করতে এখানে ফিরে আসুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A Configuració del Sistema, ves a Notificacions → Alertivity i activa Permet les notificacions. Torna aquí per actualitzar l’estat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V Nastavení systému vyberte Oznámení → Alertivity a zapněte Povolit oznámení. Návratem sem obnovíte stav."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg Notifikationer → Alertivity i Systemindstillinger, og slå Tillad notifikationer til. Vend tilbage hertil for at opdatere status."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στις Ρυθμίσεις συστήματος επιλέξτε Γνωστοποιήσεις → Alertivity και ενεργοποιήστε την αποδοχή γνωστοποιήσεων. Επιστρέψτε εδώ για ανανέωση της κατάστασης."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings, choose Notifications → Alertivity and turn on Allow Notifications. Return here to refresh the status."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings, choose Notifications → Alertivity and turn on Allow Notifications. Return here to refresh the status."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings, choose Notifications → Alertivity and turn on Allow Notifications. Return here to refresh the status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
