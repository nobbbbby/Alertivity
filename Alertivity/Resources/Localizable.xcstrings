          "stringUnit": {
            "state": "translated",
            "value": "Alerts after %d seconds of Critical activity, at least %@ apart. Includes high-activity processes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertas tras %d s de actividad crítica, separadas al menos por %@. Incluye procesos con actividad elevada."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertas tras %d s de actividad crítica, separadas al menos por %@. Incluye procesos con actividad elevada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoittaa kriittisen aktiivisuuden jatkuttua %d s, vähintään %@ välein. Sisältää suuren aktiivisuuden prosessit."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertes après %d s d’activité critique, espacées d’au moins %@. Inclut les processus à forte activité."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d સેકંડની ગંભીર પ્રવૃત્તિ પછી, ઓછામાં ઓછા %2$@ ના અંતરે ચેતવણી. ઊંચી પ્રવૃત્તિવાળી પ્રક્રિયાઓ પણ સમાવિષ્ટ છે."
          }
