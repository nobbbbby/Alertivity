  "settings.menuBar.tintedIcon.help": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Use activity colors for the menu bar icon. Turn off for a monochrome appearance."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Aktivitätsfarben für das Menüleistensymbol verwenden. Für eine einfarbige Darstellung ausschalten."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Utiliser les couleurs d’activité pour l’icône de la barre des menus. Désactivez cette option pour une apparence monochrome."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "メニューバーのアイコンにアクティビティの色を使用します。オフにするとモノクロで表示されます。"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "使用活动状态颜色显示菜单栏图标。关闭后使用单色外观。"
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "استخدام ألوان النشاط لأيقونة شريط القوائم. يمكن إيقافه لعرض بلون واحد."
        }
      },
      "bn": {
        "stringUnit": {
          "state": "translated",
          "value": "মেনু বারের আইকনে অ্যাক্টিভিটির রং ব্যবহার করুন। একরঙা দেখতে বন্ধ করুন।"
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "Fes servir els colors d’activitat per a la icona de la barra de menús. Desactiva l’opció per mostrar-la en un sol color."
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Používat pro ikonu na řádku nabídek barvy aktivity. Vypnutím získáte jednobarevný vzhled."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Brug aktivitetsfarver til symbolet på menulinjen. Slå fra for et ensfarvet udseende."
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Χρήση χρωμάτων δραστηριότητας για το εικονίδιο της γραμμής μενού. Απενεργοποιήστε για μονόχρωμη εμφάνιση."
        }
      },
      "en-AU": {
        "stringUnit": {
          "state": "translated",
          "value": "Use activity colours for the menu bar icon. Turn off for a monochrome appearance."
        }
      },
      "en-CA": {
        "stringUnit": {
          "state": "translated",
          "value": "Use activity colours for the menu bar icon. Turn off for a monochrome appearance."
        }
      },
      "en-GB": {
        "stringUnit": {
          "state": "translated",
          "value": "Use activity colours for the menu bar icon. Turn off for a monochrome appearance."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Usar los colores de actividad en el icono de la barra de menús. Desactiva esta opción para mostrarlo en un solo color."
        }
      },
      "es-MX": {
        "stringUnit": {
          "state": "translated",
          "value": "Usar los colores de actividad en el icono de la barra de menús. Desactiva esta opción para mostrarlo en un solo color."
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Käytä valikkorivin kuvakkeessa aktiivisuuden värejä. Poista käytöstä, jos haluat yksivärisen kuvakkeen."
        }
      },
      "fr-CA": {
        "stringUnit": {
          "state": "translated",
          "value": "Utiliser les couleurs d’activité pour l’icône de la barre des menus. Désactivez cette option pour une apparence monochrome."
        }
      },
      "gu": {
        "stringUnit": {
          "state": "translated",
          "value": "મેનૂ બારના આઇકન માટે પ્રવૃત્તિના રંગ વાપરો. એકરંગી દેખાવ માટે બંધ કરો."
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "שימוש בצבעי הפעילות עבור האייקון בשורת התפריטים. יש לכבות למראה בצבע אחד."
        }
      },
      "hi": {
        "stringUnit": {
          "state": "translated",
          "value": "मेनू बार आइकॉन के लिए गतिविधि के रंग इस्तेमाल करें। एक रंग में दिखाने के लिए बंद करें।"
        }
      },
      "hr": {
        "stringUnit": {
          "state": "translated",
          "value": "Koristi boje aktivnosti za ikonu u traci izbornika. Isključi za jednobojni izgled."
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "A menüsáv ikonjához a tevékenység színeit használja. Kikapcsolva egyszínű lesz."
        }
      },
      "id": {
        "stringUnit": {
          "state": "translated",
          "value": "Gunakan warna aktivitas untuk ikon bar menu. Matikan untuk tampilan monokrom."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Usa i colori dell’attività per l’icona nella barra dei menu. Disattiva per un aspetto monocromatico."
        }
      },
      "kn": {
        "stringUnit": {
          "state": "translated",
          "value": "ಮೆನು ಬಾರ್ ಐಕಾನ್‌ಗೆ ಚಟುವಟಿಕೆಯ ಬಣ್ಣಗಳನ್ನು ಬಳಸಿ. ಒಂದೇ ಬಣ್ಣದ ನೋಟಕ್ಕಾಗಿ ಆಫ್ ಮಾಡಿ."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "메뉴 막대 아이콘에 활동 상태 색상을 사용합니다. 끄면 단색으로 표시됩니다."
        }
      },
      "ml": {
        "stringUnit": {
          "state": "translated",
          "value": "മെനു ബാർ ഐക്കണിൽ ആക്റ്റിവിറ്റി നിറങ്ങൾ ഉപയോഗിക്കൂ. ഒറ്റ നിറത്തിൽ കാണാൻ ഓഫ് ചെയ്യൂ."
        }
      },
      "mr": {
        "stringUnit": {
          "state": "translated",
          "value": "मेनू बारमधील चिन्हासाठी ॲक्टिव्हिटीचे रंग वापरा. एकाच रंगात दाखवण्यासाठी बंद करा."
        }
      },
      "ms": {
        "stringUnit": {
          "state": "translated",
          "value": "Gunakan warna aktiviti untuk ikon bar menu. Matikan untuk penampilan monokrom."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Bruk aktivitetsfarger for symbolet i menylinjen. Slå av for et ensfarget utseende."
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "Gebruik activiteitskleuren voor het menubalksymbool. Schakel uit voor een monochrome weergave."
        }
      },
      "or": {
        "stringUnit": {
          "state": "translated",
          "value": "ମେନୁ ବାର୍ ଆଇକନ୍ ପାଇଁ କାର୍ଯ୍ୟକଳାପର ରଙ୍ଗ ବ୍ୟବହାର କରନ୍ତୁ। ଏକ ରଙ୍ଗର ରୂପ ପାଇଁ ବନ୍ଦ କରନ୍ତୁ।"
        }
      },
      "pa": {
        "stringUnit": {
          "state": "translated",
          "value": "ਮੀਨੂ ਬਾਰ ਆਈਕਨ ਲਈ ਸਰਗਰਮੀ ਦੇ ਰੰਗ ਵਰਤੋ। ਇਕੋ ਰੰਗ ਵਿੱਚ ਦਿਖਾਉਣ ਲਈ ਬੰਦ ਕਰੋ।"
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Używaj kolorów aktywności dla ikony na pasku menu. Wyłącz, aby uzyskać wygląd monochromatyczny."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Usar cores de atividade no ícone da barra de menus. Desative para uma aparência monocromática."
        }
      },
      "pt-PT": {
        "stringUnit": {
          "state": "translated",
          "value": "Usar cores de atividade no ícone da barra de menus. Desative para uma aparência monocromática."
        }
      },
      "ro": {
        "stringUnit": {
          "state": "translated",
          "value": "Folosește culorile activității pentru pictograma din bara de meniu. Dezactivează pentru un aspect monocrom."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Использовать цвета активности для значка в строке меню. Выключите для монохромного отображения."
        }
      },
      "sk": {
        "stringUnit": {
          "state": "translated",
          "value": "Používať pre ikonu v lište farby aktivity. Vypnutím získate jednofarebný vzhľad."
