    "settings.notifications.note.direct" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnungen nach %d Sekunden kritischer Aktivität, mit mindestens %@ Abstand. Einschließlich Prozessen mit hoher Aktivität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts after %d seconds of Critical activity, at least %@ apart. Includes high-activity processes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alertes après %d secondes d’activité critique, espacées d’au moins %@. Inclut les processus à forte activité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重大な状態が %d 秒続くと通知。通知間隔は最短 %@。高負荷プロセスも対象。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "严重活动持续 %d 秒后提醒，通知间隔至少 %@。包括高活动进程。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنبيهات بعد %d ث من النشاط الحرج، بفاصل لا يقل عن %@. تشمل العمليات ذات النشاط المرتفع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d সেকেন্ড সংকটজনক অ্যাক্টিভিটির পর সতর্কতা, অন্তত %2$@ বিরতিতে। উচ্চ অ্যাক্টিভিটির প্রসেসও অন্তর্ভুক্ত।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa després de %d s d’activitat crítica, amb un interval mínim de %@. Inclou els processos amb activitat alta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozorní po %d s kritické aktivity s odstupem alespoň %@. Zahrnuje procesy s vysokou aktivitou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Advarer efter %d sek. med kritisk aktivitet, med mindst %@ mellem advarsler. Omfatter processer med høj aktivitet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ειδοποιήσεις μετά από %d δευτ. κρίσιμης δραστηριότητας, με διάστημα τουλάχιστον %@. Περιλαμβάνονται διεργασίες υψηλής δραστηριότητας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts after %d seconds of Critical activity, at least %@ apart. Includes high-activity processes."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts after %d seconds of Critical activity, at least %@ apart. Includes high-activity processes."
          }
        },
