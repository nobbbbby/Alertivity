            "value" : "Your Mac at a glance"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac en un coup d’œil"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macの状態をひと目で"
          }
        },
        "zh-Hans" : {
