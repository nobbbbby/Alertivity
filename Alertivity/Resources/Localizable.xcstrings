      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Impossibile ripristinare gli acquisti. Riprova."
        }
      },
      "kn": {
        "stringUnit": {
          "state": "translated",
          "value": "ಖರೀದಿಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸಲಾಗಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "구입 항목을 복원할 수 없습니다. 다시 시도하십시오."
