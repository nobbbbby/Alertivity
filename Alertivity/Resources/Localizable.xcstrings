        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambang memori menggunakan persentase memori fisik yang digunakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soglie della memoria usano la percentuale di memoria fisica in uso."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೆಮೊರಿ ಮಿತಿಗಳು ಬಳಕೆಯಲ್ಲಿರುವ ಭೌತಿಕ ಮೆಮೊರಿಯ ಶೇಕಡಾವಾರು ಪ್ರಮಾಣವನ್ನು ಬಳಸುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리 임계값은 사용 중인 물리적 메모리의 비율을 기준으로 합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മെമ്മറി പരിധികൾ ഉപയോഗിക്കുന്ന ഫിസിക്കൽ മെമ്മറിയുടെ ശതമാനം ഉപയോഗിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मेमरीच्या मर्यादा वापरातील प्रत्यक्ष मेमरीच्या टक्केवारीवर आधारित असतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambang memori menggunakan peratusan memori fizikal yang digunakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Minnegrenser bruker prosentandelen fysisk minne som er i bruk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geheugendrempels gebruiken het percentage fysiek geheugen dat in gebruik is."
