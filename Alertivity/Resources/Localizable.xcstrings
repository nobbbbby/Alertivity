  "pro.lock.metricPriority": {
    "comment": "Pro metric priority customization.",
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Requires Pro. Free uses CPU → Memory → Disk → Network. Unlock in Settings → Pro."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Erfordert Pro. Kostenlos gilt CPU → Speicher → Datenträger → Netzwerk. Freischalten unter Einstellungen → Pro."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Nécessite Pro. La version gratuite utilise Processeur → Mémoire → Disque → Réseau. Déverrouillez dans Réglages → Pro."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro が必要です。無料版では CPU → メモリ → ディスク → ネットワークの順序を使用します。設定 → Pro で購入できます。"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "需要 Pro。免费版使用 CPU → 内存 → 磁盘 → 网络顺序。在设置 → Pro 中解锁。"
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "يتطلب Pro. تستخدم النسخة المجانية CPU → الذاكرة → القرص → الشبكة. يمكن فتح القفل من الإعدادات → Pro."
        }
      },
      "bn": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro প্রয়োজন। বিনামূল্যের সংস্করণে CPU → মেমরি → ডিস্ক → নেটওয়ার্ক ব্যবহৃত হয়। সেটিংস → Pro থেকে আনলক করুন।"
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "Cal el Pro. La versió gratuïta fa servir CPU → Memòria → Disc → Xarxa. Desbloqueja’l a Configuració → Pro."
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Vyžaduje Pro. Bezplatná verze používá CPU → Paměť → Disk → Síť. Odemkněte v Nastavení → Pro."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Kræver Pro. Gratis bruger CPU → Hukommelse → Disk → Netværk. Lås op i Indstillinger → Pro."
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Απαιτείται Pro. Η δωρεάν έκδοση χρησιμοποιεί CPU → Μνήμη → Δίσκος → Δίκτυο. Ξεκλειδώστε στις Ρυθμίσεις → Pro."
        }
      },
      "en-AU": {
        "stringUnit": {
          "state": "translated",
          "value": "Requires Pro. Free uses CPU → Memory → Disk → Network. Unlock in Settings → Pro."
        }
      },
      "en-CA": {
        "stringUnit": {
          "state": "translated",
          "value": "Requires Pro. Free uses CPU → Memory → Disk → Network. Unlock in Settings → Pro."
        }
      },
      "en-GB": {
        "stringUnit": {
          "state": "translated",
          "value": "Requires Pro. Free uses CPU → Memory → Disk → Network. Unlock in Settings → Pro."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Requiere Pro. La versión gratuita usa CPU → Memoria → Disco → Red. Desbloquéalo en Ajustes → Pro."
        }
      },
      "es-MX": {
        "stringUnit": {
          "state": "translated",
          "value": "Requiere Pro. La versión gratuita usa CPU → Memoria → Disco → Red. Desbloquéalo en Configuración → Pro."
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Vaatii Pron. Maksuton versio käyttää järjestystä CPU → Muisti → Levy → Verkko. Avaa kohdassa Asetukset → Pro."
        }
      },
      "fr-CA": {
        "stringUnit": {
          "state": "translated",
          "value": "Nécessite Pro. La version gratuite utilise Processeur → Mémoire → Disque → Réseau. Déverrouillez dans Réglages → Pro."
        }
      },
      "gu": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro જરૂરી છે. મફતમાં CPU → મેમરી → ડિસ્ક → નેટવર્ક વપરાય છે. સેટિંગ્સ → Pro માં અનલૉક કરો."
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "נדרש Pro. הגרסה החינמית משתמשת בסדר CPU → זיכרון → כונן → רשת. ניתן לפתוח בהגדרות → Pro."
        }
      },
      "hi": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro आवश्यक है। मुफ़्त संस्करण CPU → मेमोरी → डिस्क → नेटवर्क क्रम इस्तेमाल करता है। सेटिंग्ज़ → Pro में अनलॉक करें।"
        }
      },
      "hr": {
        "stringUnit": {
          "state": "translated",
          "value": "Zahtijeva Pro. Besplatna verzija koristi CPU → Memorija → Disk → Mreža. Otključaj u odjeljku Postavke → Pro."
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro szükséges. Az ingyenes sorrend: CPU → Memória → Lemez → Hálózat. Feloldás: Beállítások → Pro."
        }
      },
      "id": {
        "stringUnit": {
          "state": "translated",
          "value": "Memerlukan Pro. Versi gratis menggunakan CPU → Memori → Disk → Jaringan. Buka di Pengaturan → Pro."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Richiede Pro. La versione gratuita usa CPU → Memoria → Disco → Rete. Sblocca in Impostazioni → Pro."
        }
      },
      "kn": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro ಅಗತ್ಯವಿದೆ. ಉಚಿತ ಆವೃತ್ತಿಯಲ್ಲಿ CPU → ಮೆಮೊರಿ → ಡಿಸ್ಕ್ → ನೆಟ್‌ವರ್ಕ್ ಬಳಸಲಾಗುತ್ತದೆ. ಸೆಟ್ಟಿಂಗ್ಸ್ → Pro ನಲ್ಲಿ ಅನ್‌ಲಾಕ್ ಮಾಡಿ."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro가 필요합니다. 무료 버전은 CPU → 메모리 → 디스크 → 네트워크 순서를 사용합니다. 설정 → Pro에서 잠금 해제하십시오."
        }
      },
      "ml": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro ആവശ്യമാണ്. സൗജന്യ പതിപ്പ് CPU → മെമ്മറി → ഡിസ്ക് → നെറ്റ്‌വർക്ക് ഉപയോഗിക്കുന്നു. ക്രമീകരണം → Pro വഴി അൺലോക്ക് ചെയ്യൂ."
        }
      },
      "mr": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro आवश्यक आहे. मोफत आवृत्तीत CPU → मेमरी → डिस्क → नेटवर्क क्रम असतो. सेटिंग्ज → Pro मध्ये अनलॉक करा."
        }
      },
      "ms": {
        "stringUnit": {
          "state": "translated",
          "value": "Memerlukan Pro. Versi percuma menggunakan CPU → Memori → Cakera → Rangkaian. Buka kunci dalam Seting → Pro."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Krever Pro. Gratis bruker CPU → Minne → Disk → Nettverk. Lås opp i Innstillinger → Pro."
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "Vereist Pro. Gratis gebruikt CPU → Geheugen → Schijf → Netwerk. Ontgrendel in Instellingen → Pro."
        }
      },
      "or": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro ଆବଶ୍ୟକ। ମାଗଣା ସଂସ୍କରଣ CPU → ମେମୋରି → ଡିସ୍କ୍ → ନେଟୱର୍କ୍ ବ୍ୟବହାର କରେ। ସେଟିଂସ୍ → Pro ରେ ଅନଲକ୍ କରନ୍ତୁ।"
        }
      },
      "pa": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro ਲੋੜੀਂਦਾ ਹੈ। ਮੁਫ਼ਤ ਵਰਜਨ CPU → ਮੈਮੋਰੀ → ਡਿਸਕ → ਨੈੱਟਵਰਕ ਕ੍ਰਮ ਵਰਤਦਾ ਹੈ। ਸੈਟਿੰਗਾਂ → Pro ਵਿੱਚ ਅਨਲੌਕ ਕਰੋ।"
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Wymaga Pro. Wersja bezpłatna używa kolejności CPU → Pamięć → Dysk → Sieć. Odblokuj w sekcji Ustawienia → Pro."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Requer Pro. A versão gratuita usa CPU → Memória → Disco → Rede. Desbloqueie em Ajustes → Pro."
        }
      },
      "pt-PT": {
        "stringUnit": {
          "state": "translated",
          "value": "Requer Pro. A versão gratuita usa CPU → Memória → Disco → Rede. Desbloqueie em Definições → Pro."
        }
      },
      "ro": {
        "stringUnit": {
          "state": "translated",
          "value": "Necesită Pro. Versiunea gratuită folosește CPU → Memorie → Disc → Rețea. Deblochează în Configurări → Pro."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Требуется Pro. В бесплатной версии: CPU → Память → Диск → Сеть. Разблокируйте в Настройках → Pro."
        }
      },
      "sk": {
        "stringUnit": {
          "state": "translated",
          "value": "Vyžaduje Pro. Bezplatná verzia používa CPU → Pamäť → Disk → Sieť. Odomknite v časti Nastavenia → Pro."
        }
      },
      "sl": {
        "stringUnit": {
          "state": "translated",
          "value": "Zahteva Pro. Brezplačna različica uporablja CPU → Pomnilnik → Disk → Omrežje. Odkleni v razdelku Nastavitve → Pro."
        }
      },
      "sv": {
        "stringUnit": {
          "state": "translated",
          "value": "Kräver Pro. Gratis använder CPU → Minne → Skiva → Nätverk. Lås upp i Inställningar → Pro."
        }
      },
      "ta": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro தேவை. இலவசப் பதிப்பில் CPU → நினைவகம் → வட்டு → நெட்வொர்க் பயன்படுத்தப்படும். அமைப்புகள் → Pro இல் திறக்கலாம்."
        }
      },
      "te": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro అవసరం. ఉచిత వెర్షన్ CPU → మెమరీ → డిస్క్ → నెట్‌వర్క్ వాడుతుంది. సెట్టింగ్స్ → Pro లో అన్‌లాక్ చేయండి."
        }
      },
      "th": {
        "stringUnit": {
          "state": "translated",
          "value": "ต้องใช้ Pro รุ่นฟรีใช้ CPU → หน่วยความจำ → ดิสก์ → เครือข่าย ปลดล็อคในการตั้งค่า → Pro"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro gerektirir. Ücretsiz sürüm CPU → Bellek → Disk → Ağ sırasını kullanır. Ayarlar → Pro bölümünden kilidi açın."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Потрібен Pro. Безкоштовна версія: CPU → Памʼять → Диск → Мережа. Розблокуйте в Параметрах → Pro."
        }
      },
      "ur": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro درکار ہے۔ مفت نسخے کی ترتیب CPU ← میموری ← ڈسک ← نیٹ ورک ہے۔ ترتیبات ← Pro میں کھولیں۔"
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Yêu cầu Pro. Bản miễn phí dùng CPU → Bộ nhớ → Ổ đĩa → Mạng. Mở khóa trong Cài đặt → Pro."
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "需要 Pro。免費版依 CPU → 記憶體 → 磁碟 → 網路的順序選取。可在「設定」→ Pro 解鎖。"
        }
      }
    }
  },
