    "settings.ignoredProcesses.help" : {
      "comment" : "Explains the effect and limits of ignoring a process.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prozesse auf der Ausnahmeliste werden nicht in Warnungen zu hoher Aktivität angezeigt, ihre Nutzung wird jedoch weiterhin in die allgemeinen Systemmetriken einbezogen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whitelisted processes won’t appear in high-activity alerts, but their usage still counts toward overall system metrics."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les processus ignorés n’apparaîtront pas dans les alertes de forte activité, mais leur utilisation sera toujours prise en compte dans les métriques système globales."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無視するプロセスは高負荷の通知には表示されませんが、その使用量は引き続きシステム全体の指標に含まれます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忽略列表中的进程不会出现在高活动提醒中，但其资源使用情况仍会计入整体系统指标。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تظهر العمليات المسموح بها في تنبيهات النشاط المرتفع، لكن يظل استهلاكها محسوبًا ضمن مقاييس النظام الإجمالية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমোদিত তালিকার প্রসেস উচ্চ অ্যাক্টিভিটির সতর্কতায় দেখা যাবে না, তবে তাদের ব্যবহার সিস্টেমের মোট মেট্রিকে গণনা করা হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els processos permesos no apareixen als avisos d’activitat alta, però el seu ús continua comptant a les mètriques globals."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolené procesy se nezobrazují v upozorněních na vysokou aktivitu, jejich využití se však stále započítává do celkových metrik systému."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilladte processer vises ikke i advarsler om høj aktivitet, men deres forbrug tæller stadig med i systemets samlede metrikker."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εξαιρούμενες διεργασίες δεν εμφανίζονται στις ειδοποιήσεις υψηλής δραστηριότητας, αλλά η χρήση τους προσμετράται στις συνολικές μετρήσεις συστήματος."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Whitelisted processes won’t appear in high-activity alerts, but their usage still counts towards overall system metrics."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Whitelisted processes won’t appear in high-activity alerts, but their usage still counts toward overall system metrics."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Whitelisted processes won’t appear in high-activity alerts, but their usage still counts towards overall system metrics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los procesos permitidos no aparecerán en las alertas de actividad elevada, pero su uso seguirá contando en las métricas generales del sistema."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los procesos permitidos no aparecerán en las alertas de actividad elevada, pero su uso seguirá contando en las métricas generales del sistema."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sallittujen luettelon prosessit eivät näy suuren aktiivisuuden ilmoituksissa, mutta niiden käyttö lasketaan silti järjestelmän kokonaismittareihin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les processus ignorés n’apparaîtront pas dans les alertes de forte activité, mais leur utilisation sera toujours prise en compte dans les métriques système globales."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છૂટની સૂચિની પ્રક્રિયાઓ ઊંચી પ્રવૃત્તિની ચેતવણીઓમાં નહીં દેખાય, પણ તેમનો વપરાશ સિસ્ટમના કુલ માપદંડમાં ગણાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תהליכים ברשימת ההיתרים לא יופיעו בהתראות פעילות גבוהה, אך הניצול שלהם עדיין ייכלל במדדי המערכת הכוללים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमत सूची के प्रोसेस अधिक गतिविधि के अलर्ट में नहीं दिखेंगे, लेकिन उनका उपयोग सिस्टम के कुल मेट्रिक में गिना जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesi na popisu dopuštenih ne pojavljuju se u upozorenjima na visoku aktivnost, ali njihovo korištenje i dalje ulazi u ukupne mjerne podatke sustava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az engedélyezett folyamatok nem jelennek meg a magas aktivitású riasztásokban, de használatuk beleszámít a rendszer teljes mérőszámaiba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proses yang diizinkan tidak muncul dalam peringatan aktivitas tinggi, tetapi penggunaannya tetap dihitung dalam metrik sistem keseluruhan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I processi consentiti non appaiono negli avvisi di attività elevata, ma il loro utilizzo conta comunque nelle metriche totali di sistema."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಿನಾಯಿತಿ ಪಟ್ಟಿಯ ಪ್ರಕ್ರಿಯೆಗಳು ಹೆಚ್ಚಿನ ಚಟುವಟಿಕೆ ಸೂಚನೆಗಳಲ್ಲಿ ಕಾಣುವುದಿಲ್ಲ, ಆದರೆ ಅವುಗಳ ಬಳಕೆ ಒಟ್ಟು ಸಿಸ್ಟಂ ಮಾಪನಗಳಲ್ಲಿ ಸೇರುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용 목록의 프로세스는 높은 활동 알림에 표시되지 않지만 사용량은 전체 시스템 지표에 포함됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒഴിവാക്കൽ പട്ടികയിലെ പ്രോസസുകൾ ഉയർന്ന ആക്റ്റിവിറ്റി അറിയിപ്പുകളിൽ കാണില്ല. അവയുടെ ഉപയോഗം മൊത്തം സിസ്റ്റം മെട്രിക്കുകളിൽ ഉൾപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "परवानगी यादीतील प्रक्रिया उच्च ॲक्टिव्हिटीच्या सूचनांमध्ये दिसणार नाहीत, पण त्यांचा वापर सिस्टमच्या एकूण मेट्रिकमध्ये मोजला जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Proses yang dibenarkan tidak akan muncul dalam amaran aktiviti tinggi, tetapi penggunaannya masih dikira dalam metrik keseluruhan sistem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillatte prosesser vises ikke i varsler om høy aktivitet, men forbruket deres teller fortsatt med i systemets samlede målinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegestane processen verschijnen niet in waarschuwingen voor hoge activiteit, maar hun verbruik telt wel mee in de totale systeemmetrieken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଛାଡ଼ ତାଲିକାର ପ୍ରୋସେସ୍ ଅଧିକ କାର୍ଯ୍ୟକଳାପ ଚେତାବନୀରେ ଦେଖାଯିବ ନାହିଁ, କିନ୍ତୁ ସେଗୁଡ଼ିକର ବ୍ୟବହାର ସିଷ୍ଟମ୍‌ର ମୋଟ ମାପକରେ ଗଣାଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਜਾਜ਼ਤ ਸੂਚੀ ਵਾਲੇ ਪ੍ਰੋਸੈੱਸ ਵੱਧ ਸਰਗਰਮੀ ਦੇ ਅਲਰਟ ਵਿੱਚ ਨਹੀਂ ਦਿਖਣਗੇ, ਪਰ ਉਹਨਾਂ ਦੀ ਵਰਤੋਂ ਸਿਸਟਮ ਦੇ ਕੁੱਲ ਮੈਟ੍ਰਿਕ ਵਿੱਚ ਗਿਣੀ ਜਾਵੇਗੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesy z listy dozwolonych nie pojawiają się w alertach o wysokiej aktywności, lecz ich użycie nadal wlicza się do łącznych wskaźników systemu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os processos permitidos não aparecerão nos alertas de alta atividade, mas seu uso ainda será contabilizado nas métricas gerais do sistema."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os processos permitidos não aparecerão nos alertas de atividade elevada, mas seu uso ainda será contabilizado nas métricas gerais do sistema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesele permise nu apar în alertele de activitate intensă, dar utilizarea lor contează în continuare în indicatorii totali ai sistemului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешённые процессы не отображаются в предупреждениях о высокой активности, но их потребление учитывается в общих показателях системы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolené procesy sa nezobrazujú v upozorneniach na vysokú aktivitu, ich využitie sa však naďalej započítava do celkových metrík systému."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovoljeni procesi se ne prikažejo v opozorilih o visoki dejavnosti, vendar se njihova poraba še vedno všteva v skupne sistemske meritve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåtna processer visas inte i varningar om hög aktivitet, men deras användning räknas fortfarande in i systemets totala mätvärden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விலக்குப் பட்டியல் செயல்முறைகள் அதிகச் செயல்பாட்டு அறிவிப்புகளில் காட்டப்படாது. அவற்றின் பயன்பாடு மொத்தக் கணினி அளவீடுகளில் தொடர்ந்து கணக்கிடப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మినహాయింపు జాబితా ప్రాసెస్‌లు అధిక కార్యకలాప హెచ్చరికల్లో కనిపించవు, కానీ వాటి వినియోగం మొత్తం సిస్టమ్ కొలమానాల్లో లెక్కించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระบวนการในรายการยกเว้นจะไม่ปรากฏในการแจ้งเตือนกิจกรรมสูง แต่การใช้งานยังนับรวมในตัววัดระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin listesindeki işlemler yüksek etkinlik uyarılarında görünmez ancak kullanımları genel sistem ölçümlerine dahil edilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволені процеси не зʼявляються в попередженнях про високу активність, але їхнє споживання враховується в загальних показниках системи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مستثنیٰ پراسیس زیادہ سرگرمی کی اطلاعات میں نہیں آئیں گے، مگر ان کا استعمال سسٹم کے کل پیمانوں میں شامل رہے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiến trình trong danh sách cho phép không xuất hiện trong cảnh báo hoạt động cao, nhưng mức sử dụng vẫn được tính vào chỉ số toàn hệ thống."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許清單中的程序不會出現在高活動通知中，但其用量仍會計入系統總指標。"
          }
        }
      }
    },
