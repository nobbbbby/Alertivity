          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क की सीमाएँ डाउनलोड और अपलोड के संयुक्त थ्रूपुट पर आधारित हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pragovi mreže koriste zbroj propusnosti preuzimanja i slanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hálózati küszöbök a letöltés és feltöltés együttes átviteli sebességét használják."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambang jaringan menggunakan gabungan laju unduh dan unggah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soglie di rete usano la velocità combinata di download e upload."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೆಟ್‌ವರ್ಕ್ ಮಿತಿಗಳು ಡೌನ್‌ಲೋಡ್ ಮತ್ತು ಅಪ್‌ಲೋಡ್‌ನ ಸಂಯೋಜಿತ ಡೇಟಾ ದರವನ್ನು ಬಳಸುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 임계값은 다운로드와 업로드의 합산 처리량을 기준으로 합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നെറ്റ്‌വർക്ക് പരിധികൾ ഡൗൺലോഡിന്റെയും അപ്‌ലോഡിന്റെയും സംയുക്ത ഡാറ്റാ നിരക്ക് ഉപയോഗിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्कच्या मर्यादा डाउनलोड आणि अपलोडच्या एकत्रित डेटा दरावर आधारित असतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambang rangkaian menggunakan gabungan daya pemprosesan muat turun dan muat naik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettverksgrenser bruker samlet gjennomstrømming for nedlasting og opplasting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Netwerkdrempels gebruiken de gecombineerde download- en uploaddoorvoer."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନେଟୱର୍କ୍ ସୀମାରେ ଡାଉନଲୋଡ୍ ଓ ଅପଲୋଡ୍‌ର ମିଳିତ ଡାଟା ହାର ଧରାଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨੈੱਟਵਰਕ ਦੀਆਂ ਹੱਦਾਂ ਡਾਊਨਲੋਡ ਅਤੇ ਅੱਪਲੋਡ ਦੇ ਸਾਂਝੇ ਥ੍ਰੂਪੁੱਟ ਉੱਤੇ ਆਧਾਰਿਤ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Progi sieci używają łącznej przepustowości pobierania i wysyłania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os limites de rede usam a taxa combinada de download e upload."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os limites de rede usam a taxa combinada de descarga e envio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pragurile rețelei folosesc debitul combinat de descărcare și încărcare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пороги сети используют суммарную скорость загрузки и отдачи."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prahy siete používajú súčet rýchlostí sťahovania a odosielania."
          }
        },
        "sl": {
          "stringUnit": {
