      },
      "hr": {
        "stringUnit": {
          "state": "translated",
          "value": "Nije moguće obnoviti kupnje. Pokušaj ponovno."
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "A vásárlások nem állíthatók vissza. Próbálja újra."
