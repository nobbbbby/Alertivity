      "te": {
        "stringUnit": {
          "state": "translated",
          "value": "కొనుగోళ్లను పునరుద్ధరించలేకపోయాం. మళ్లీ ప్రయత్నించండి."
        }
      },
      "th": {
        "stringUnit": {
          "state": "translated",
          "value": "กู้คืนรายการซื้อไม่ได้ โปรดลองอีกครั้ง"
