    "NSUserNotificationUsageDescription" : {
      "comment" : "Explains activity alerts. Process alerts are available only in the non-sandboxed source build.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alertivity sendet Warnungen, wenn die Systemaktivität kritisch ist oder ein Prozess Probleme verursacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alertivity sends alerts when system activity is critical or a process is misbehaving."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alertivity envoie des alertes lorsque l’activité du système est critique ou qu’un processus fonctionne mal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alertivityは、システムのアクティビティが重大な状態になった場合や、プロセスに問題が発生した場合に通知します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当系统活动达到严重级别或进程出现异常时，Alertivity 会发送提醒。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يرسل Alertivity تنبيهات عند وصول نشاط النظام إلى مستوى حرج أو عند وجود مشكلة في عملية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সিস্টেম অ্যাক্টিভিটি সংকটজনক হলে বা কোনও প্রসেস অস্বাভাবিক আচরণ করলে Alertivity থেকে সতর্কতা পাঠানো হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’Alertivity envia avisos quan l’activitat del sistema és crítica o un procés funciona malament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity posílá upozornění při kritické aktivitě systému nebo nesprávném chování procesu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity sender advarsler, når systemaktiviteten er kritisk, eller en proces ikke fungerer korrekt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το Alertivity στέλνει ειδοποιήσεις όταν η δραστηριότητα του συστήματος είναι κρίσιμη ή μια διεργασία δυσλειτουργεί."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity sends alerts when system activity is critical or a process is misbehaving."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity sends alerts when system activity is critical or a process is misbehaving."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity sends alerts when system activity is critical or a process is misbehaving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity envía alertas cuando la actividad del sistema es crítica o un proceso funciona mal."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity envía alertas cuando la actividad del sistema es crítica o un proceso funciona mal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity lähettää ilmoituksia järjestelmän aktiivisuuden ollessa kriittistä tai prosessin toimiessa virheellisesti."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity envoie des alertes lorsque l’activité du système est critique ou qu’un processus fonctionne mal."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "સિસ્ટમ પ્રવૃત્તિ ગંભીર હોય અથવા પ્રક્રિયા અસામાન્ય હોય ત્યારે Alertivity ચેતવણી મોકલે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity שולח התראות כשפעילות המערכת קריטית או כשתהליך פועל באופן לא תקין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सिस्टम गतिविधि गंभीर होने या प्रोसेस में समस्या आने पर Alertivity अलर्ट भेजता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity šalje upozorenja kad je aktivnost sustava kritična ili proces ne radi ispravno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az Alertivity riasztást küld, ha a rendszer aktivitása kritikus, vagy egy folyamat hibásan működik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity mengirim peringatan saat aktivitas sistem kritis atau proses bermasalah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity invia avvisi quando l’attività di sistema è critica o un processo non funziona correttamente."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸಿಸ್ಟಂ ಚಟುವಟಿಕೆ ಗಂಭೀರವಾಗಿದ್ದಾಗ ಅಥವಾ ಪ್ರಕ್ರಿಯೆ ಅಸಹಜವಾಗಿದ್ದಾಗ Alertivity ಎಚ್ಚರಿಕೆಗಳನ್ನು ಕಳುಹಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시스템 활동이 심각하거나 프로세스에 문제가 있을 때 Alertivity가 알림을 보냅니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
