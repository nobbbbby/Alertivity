        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity invia avvisi sull’attività di sistema del Mac."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity ನಿಮ್ಮ Mac ನ ಸಿಸ್ಟಂ ಚಟುವಟಿಕೆಯ ಕುರಿತು ಎಚ್ಚರಿಕೆಗಳನ್ನು ಕಳುಹಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity가 Mac의 시스템 활동에 대한 알림을 보냅니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ Mac-ലെ സിസ്റ്റം ആക്റ്റിവിറ്റിയെക്കുറിച്ച് Alertivity മുന്നറിയിപ്പുകൾ അയയ്ക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity तुमच्या Mac वरील सिस्टमच्या ॲक्टिव्हिटीबद्दल सूचना पाठवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity menghantar amaran tentang aktiviti sistem pada Mac anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity sender varsler om systemaktiviteten på Macen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity verstuurt waarschuwingen over systeemactiviteit op je Mac."
          }
        },
        "or": {
