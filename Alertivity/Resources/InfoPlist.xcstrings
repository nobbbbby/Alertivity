          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity आपके Mac पर सिस्टम गतिविधि के बारे में अलर्ट भेजता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity šalje upozorenja o aktivnosti sustava na tvom Macu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az Alertivity riasztásokat küld a Mac rendszertevékenységéről."
