    "NSUserNotificationUsageDescription" : {
      "comment" : "Explains system activity alerts for both app variants.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alertivity sendet Warnungen zur Systemaktivität auf deinem Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alertivity sends alerts about system activity on your Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alertivity envoie des alertes sur l’activité du système sur votre Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "AlertivityはMacのシステムアクティビティに関する通知を送信します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alertivity 会发送有关 Mac 系统活动的提醒。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يرسل Alertivity تنبيهات حول نشاط النظام على Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার Mac-এর সিস্টেম অ্যাক্টিভিটি সম্পর্কে Alertivity থেকে সতর্কতা পাঠানো হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’Alertivity envia avisos sobre l’activitat del sistema al teu Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity posílá upozornění na aktivitu systému na vašem Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity sender advarsler om systemaktivitet på din Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το Alertivity στέλνει ειδοποιήσεις για τη δραστηριότητα του συστήματος στο Mac σας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alertivity sends alerts about system activity on your Mac."
          }
        },
        "en-CA": {
          "stringUnit": {
